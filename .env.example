# Публичный URL сайта (каноникалы, sitemap, OG)
PUBLIC_SITE_URL=https://innotek.uz

# Форма заявки → Telegram Bot API (Netlify Function /api/quote).
# Только серверные переменные — без префикса PUBLIC_, токен не попадает в браузер.
# Пока токена нет, форма на сайте показывает телефон как fallback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Аналитика (шаг 7). Пустые значения = скрипты не подключаются.
PUBLIC_YM_ID=
PUBLIC_GTM_ID=
