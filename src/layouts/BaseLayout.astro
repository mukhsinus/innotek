---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import MobileFab from "../components/MobileFab.astro";
import cyrillicFont from "@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url";
import latinExtFont from "@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2?url";
import latinFont from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import monoCyrFont from "@fontsource/jetbrains-mono/files/jetbrains-mono-cyrillic-400-normal.woff2?url";
import monoLatFont from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url";
import type { Lang } from "../i18n/ui";
import { currentLangFromPath, useT } from "../i18n/utils";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  overlayHeader?: boolean;
  home?: boolean;
}

const { title, description = "", overlayHeader = false, home = false } = Astro.props;
const lang = (Astro.currentLocale ?? currentLangFromPath(Astro.url.pathname)) as Lang;
const t = useT(lang);
const htmlLang = lang === "uz" ? "uz" : "ru";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cyrillicFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoCyrFont} as="font" type="font/woff2" crossorigin />
    {lang === "uz" && <link rel="preload" href={latinExtFont} as="font" type="font/woff2" crossorigin />}
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body class:list={[home && "is-home"]}>
    <a class="skip-link" href="#main">{t("skip")}</a>
    <!-- Сентинел для сжатия sticky-шапки через IntersectionObserver -->
    <div id="header-sentinel" class="pointer-events-none h-px w-full" aria-hidden="true"></div>
    <Header lang={lang} overlay={overlayHeader} />
    {!overlayHeader && <div class="header-spacer" aria-hidden="true"></div>}
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileFab lang={lang} />
    <script src="../scripts/chrome.ts"></script>
  </body>
</html>
