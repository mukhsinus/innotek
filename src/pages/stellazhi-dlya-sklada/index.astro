---
import QuoteBand from "../../components/QuoteBand.astro";
import SectionMeta from "../../components/SectionMeta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SEO_WAREHOUSE } from "../../data/examples";
import { hrefFor } from "../../i18n/utils";

const lang = "ru" as const;
const page = SEO_WAREHOUSE;
const pad = (n: number) => String(n).padStart(2, "0");
const TOTAL = 4;
---

<BaseLayout title={page.title} description={page.description}>
  <article>
    <header class="page-head bg-paper" data-reveal>
      <div class="site-wrap grid items-end gap-10 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-7">
          <SectionMeta kicker={page.kicker} index={1} total={TOTAL} />
          <h1 class="t-display">{page.h1}</h1>
          <p class="t-lead">{page.lead}</p>
        </div>
        <div class="relative aspect-[4/5] overflow-hidden bg-ink lg:col-span-4 lg:col-start-9 lg:aspect-[4/5]">
          <img
            src={page.image}
            alt=""
            class="photo-grade absolute inset-0 h-full w-full object-cover"
            width="800"
            height="1000"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </header>

    <section class="section-y bg-paper" data-reveal>
      <div class="site-wrap">
        <SectionMeta kicker="Виды" index={2} total={TOTAL} />
        <div class="max-w-2xl space-y-4 text-[1.0625rem] leading-relaxed text-muted">
          {page.intro.map((p) => <p>{p}</p>)}
        </div>
        <div class="mt-16 grid gap-0 sm:grid-cols-2">
          {
            page.types.map((item, i) => (
              <a
                href={hrefFor(lang, item.path)}
                class="group border-t border-line py-8 pr-8 last:border-b sm:border-line sm:[&:nth-child(odd)]:pr-10 sm:[&:nth-child(even)]:border-l sm:[&:nth-child(even)]:pl-10 sm:[&:nth-last-child(-n+2)]:border-b"
              >
                <p class="t-overline">{pad(i + 1)}</p>
                <h2 class="mt-4 text-2xl font-medium tracking-[-0.02em]">
                  {item.title}
                  <span class="link-arrow" aria-hidden="true"> →</span>
                </h2>
                <p class="mt-2 text-sm text-muted">{item.text}</p>
              </a>
            ))
          }
        </div>
        <ul class="mt-16 max-w-xl">
          {
            page.points.map((item, i) => (
              <li class="feature-item">
                <span class="t-overline">{pad(i + 1)}</span>
                <p>{item}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <QuoteBand lang={lang} index={3} total={TOTAL} />

    <section class="section-y bg-paper" data-reveal>
      <div class="site-wrap">
        <SectionMeta kicker={page.seo.kicker} index={4} total={TOTAL} />
        <h2 class="t-display">{page.seo.heading}</h2>
        <div class="seo-block mt-8">
          {page.seo.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div class="mt-16 max-w-3xl">
          {
            page.seo.faqs.map((item) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
