---
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SectionMeta from "../../../components/SectionMeta.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SITE } from "../../../data/site";
import { hrefFor, useT } from "../../../i18n/utils";

const lang = "ru" as const;
const t = useT(lang);
---

<BaseLayout title={`${t("form.thanksTitle")} | Innotek`} description={t("form.thanksLead")}>
  <header class="page-head bg-paper">
    <div class="site-wrap">
      <Breadcrumbs
        lang={lang}
        items={[
          { label: t("crumb.home"), path: "/" },
          { label: t("nav.contacts"), path: "/contacts/" },
          { label: t("form.thanksTitle") },
        ]}
      />
      <SectionMeta kicker={t("contacts.quote")} index={1} total={1} />
      <h1 class="t-display">{t("form.thanksTitle")}</h1>
      <p class="t-lead">{t("form.thanksLead")}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a class="btn-primary" href={`tel:${SITE.phone.tel}`}>
          {t("form.call")}
          {" "}
          {SITE.phone.display}
        </a>
        <a class="btn-ghost border-ink" href={hrefFor(lang, "/")}>{t("notFound.home")}</a>
        <a class="btn-ghost border-ink" href={hrefFor(lang, "/catalog/")}>{t("cta.catalog")}</a>
      </div>
    </div>
  </header>
</BaseLayout>
