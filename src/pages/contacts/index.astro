---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import JsonLd from "../../components/JsonLd.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import SectionMeta from "../../components/SectionMeta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACTS } from "../../data/company";
import { localBusinessLd } from "../../data/schema";
import { SITE } from "../../data/site";
import { useT } from "../../i18n/utils";

const lang = "ru" as const;
const t = useT(lang);
const TOTAL = 4;
const address = SITE.address.ru;
---

<BaseLayout title={CONTACTS.title} description={CONTACTS.description}>
  <article>
    <!-- 01 Header -->
    <header class="page-head bg-surface" data-reveal>
      <div class="site-wrap">
        <Breadcrumbs
          lang={lang}
          items={[
            { label: t("crumb.home"), path: "/" },
            { label: t("nav.contacts") },
          ]}
        />
        <div class="flex flex-wrap items-center justify-between gap-4 mt-2 mb-4">
          <SectionMeta kicker={t("page.kickerCompany")} index={1} total={TOTAL} />
          <div class="telemetry-pill" aria-label="Status">
            <span class="relative flex h-1.5 w-1.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan opacity-75"></span>
              <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-cyan"></span>
            </span>
            <span>CENTRAL DISPATCH // TASHKENT HQ</span>
          </div>
        </div>
        <h1 class="t-display">{CONTACTS.h1}</h1>
        <p class="t-lead max-w-3xl">{CONTACTS.lead}</p>
      </div>
    </header>

    <!-- 02 Communication Hub: 4-Card Industrial Grid -->
    <section class="section-y bg-paper" data-reveal>
      <div class="site-wrap">
        <SectionMeta kicker={t("nav.contacts")} index={2} total={TOTAL} />

        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Card 1: Central Hotline -->
          <div class="group relative flex flex-col justify-between rounded-xl border border-line bg-surface/70 p-6 transition-all duration-300 hover:border-accent/50 hover:bg-surface hover:shadow-lg">
            <span class="cad-cross cad-tl" aria-hidden="true">+</span>
            <span class="cad-cross cad-tr" aria-hidden="true">+</span>
            <div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs font-semibold text-cyan tracking-wider uppercase">[ 01 // ГОРОДСКОЙ ]</span>
                <span class="flex h-2 w-2 rounded-full bg-emerald-500" title="Линия активна"></span>
              </div>
              <p class="mt-4 text-xs font-mono text-muted-on-ink uppercase">{t("footer.phone")}</p>
              <a
                href={`tel:${SITE.phone.tel}`}
                class="mt-1 block font-display text-lg font-bold text-ink hover:text-accent transition-colors sm:text-xl"
              >
                {SITE.phone.display}
              </a>
            </div>
            <div class="mt-6 pt-4 border-t border-line/60">
              <a class="btn-primary w-full justify-center text-xs py-2" href={`tel:${SITE.phone.tel}`}>
                Позвонить
              </a>
            </div>
          </div>

          <!-- Card 2: Mobile Engineers -->
          <div class="group relative flex flex-col justify-between rounded-xl border border-line bg-surface/70 p-6 transition-all duration-300 hover:border-accent/50 hover:bg-surface hover:shadow-lg">
            <span class="cad-cross cad-tl" aria-hidden="true">+</span>
            <span class="cad-cross cad-tr" aria-hidden="true">+</span>
            <div>
              <span class="font-mono text-xs font-semibold text-cyan tracking-wider uppercase">[ 02 // ИНЖЕНЕРЫ ]</span>
              <p class="mt-4 text-xs font-mono text-muted-on-ink uppercase">{t("contacts.mobiles")}</p>
              <div class="mt-2 space-y-1.5 font-display text-sm font-semibold text-ink">
                {SITE.mobiles.map((mob) => (
                  <a href={`tel:${mob.tel}`} class="block text-ink hover:text-accent transition-colors">
                    {mob.display}
                  </a>
                ))}
              </div>
            </div>
            <div class="mt-6 pt-4 border-t border-line/60">
              <a
                class="btn-ghost w-full justify-center text-xs py-2 border-line text-cyan hover:border-cyan"
                href={SITE.socials.telegram}
                target="_blank"
                rel="noopener noreferrer"
              >
                Написать в Telegram ↗
              </a>
            </div>
          </div>

          <!-- Card 3: Email Dispatch -->
          <div class="group relative flex flex-col justify-between rounded-xl border border-line bg-surface/70 p-6 transition-all duration-300 hover:border-accent/50 hover:bg-surface hover:shadow-lg">
            <span class="cad-cross cad-tl" aria-hidden="true">+</span>
            <span class="cad-cross cad-tr" aria-hidden="true">+</span>
            <div>
              <span class="font-mono text-xs font-semibold text-cyan tracking-wider uppercase">[ 03 // ПОЧТА ]</span>
              <p class="mt-4 text-xs font-mono text-muted-on-ink uppercase">{t("footer.email")}</p>
              <a
                href={`mailto:${SITE.email}`}
                class="mt-1 block font-display text-lg font-bold text-ink hover:text-accent transition-colors"
              >
                {SITE.email}
              </a>
              <p class="mt-2 text-xs text-muted-on-ink leading-relaxed">
                Для чертежей, ТЗ и официальных запросов.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-line/60">
              <a class="btn-ghost w-full justify-center text-xs py-2 border-line" href={`mailto:${SITE.email}`}>
                Отправить письмо
              </a>
            </div>
          </div>

          <!-- Card 4: Operating Hours -->
          <div class="group relative flex flex-col justify-between rounded-xl border border-line bg-surface/70 p-6 transition-all duration-300 hover:border-accent/50 hover:bg-surface hover:shadow-lg">
            <span class="cad-cross cad-tl" aria-hidden="true">+</span>
            <span class="cad-cross cad-tr" aria-hidden="true">+</span>
            <div>
              <span class="font-mono text-xs font-semibold text-cyan tracking-wider uppercase">[ 04 // ГРАФИК ]</span>
              <p class="mt-4 text-xs font-mono text-muted-on-ink uppercase">{t("contacts.hours")}</p>
              <p class="mt-1 font-display text-base font-bold text-ink">
                {t("contacts.weekdays")}
              </p>
              <p class="mt-1 text-xs text-muted-on-ink leading-relaxed">
                {t("contacts.weekend")}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-line/60 flex items-center justify-between text-xs font-mono text-muted-on-ink">
              <span>TIMEZONE</span>
              <span class="font-bold text-ink">UTC+5 // TASHKENT</span>
            </div>
          </div>
        </div>

        <!-- Interactive HQ Geolocation Card -->
        <div
          data-spotlight
          class="group relative mt-8 overflow-hidden rounded-xl border border-line bg-surface/80 p-6 sm:p-8 lg:p-10 shadow-sm transition-all duration-300 hover:border-accent/40"
        >
          <span class="cad-cross cad-tl" aria-hidden="true">+</span>
          <span class="cad-cross cad-tr" aria-hidden="true">+</span>
          <span class="cad-cross cad-bl" aria-hidden="true">+</span>
          <span class="cad-cross cad-br" aria-hidden="true">+</span>

          <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center">
            <!-- Left Coordinates & Route Actions -->
            <div class="lg:col-span-5">
              <div class="telemetry-pill mb-3" aria-label="Coordinates">
                <span class="h-1.5 w-1.5 rounded-full bg-cyan"></span>
                <span>41.330056° N, 69.250178° E</span>
              </div>
              <h2 class="font-display text-xl font-bold text-ink sm:text-2xl">
                Головной офис и производство
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-muted-on-ink">
                {address}
              </p>

              <div class="mt-6 flex flex-wrap items-center gap-3">
                <a
                  class="btn-accent inline-flex items-center gap-2 text-xs py-2.5 px-5 shadow-xs"
                  href={SITE.mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>Google Maps</span>
                  <span aria-hidden="true">↗</span>
                </a>
                <a
                  class="btn-primary inline-flex items-center gap-2 text-xs py-2.5 px-5"
                  href={`https://yandex.ru/maps/?text=${encodeURIComponent(address)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>Yandex Карты</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>

            <!-- Right Map Embed Display -->
            <div class="lg:col-span-7">
              <div class="relative aspect-[16/9] overflow-hidden rounded-lg border border-line bg-paper shadow-xs sm:aspect-[16/10]">
                <iframe
                  title="Innotek Location Map"
                  src={`https://maps.google.com/maps?q=${SITE.mapsLat},${SITE.mapsLng}&hl=${lang}&z=17&output=embed`}
                  class="h-full w-full border-0 filter contrast-[1.02] grayscale-[0.05]"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 Engineering Quote & CAD Specification Request Form -->
    <section id="quote" class="section-y bg-surface border-t border-line" data-reveal>
      <div class="site-wrap grid gap-12 lg:grid-cols-12 lg:items-start">
        <!-- Left: Value Proposition & Direct Assistance -->
        <div class="lg:col-span-5">
          <SectionMeta kicker={t("contacts.quote")} index={3} total={TOTAL} />
          <h2 class="t-display mt-2">{t("cta.quote")}</h2>
          <p class="t-lead text-base sm:text-lg mt-3 text-muted-on-ink leading-relaxed">
            Отправьте параметры объекта или проектное задание. Наш инженер рассчитает нагрузки, подготовит 3D-расстановку и составит коммерческое предложение.
          </p>

          <div class="mt-8 space-y-4">
            <div class="flex items-start gap-3.5 rounded-lg border border-line bg-paper p-4 shadow-xs">
              <span class="font-mono text-xs font-bold text-accent mt-0.5">01</span>
              <div>
                <p class="text-sm font-semibold text-ink">Бесплатный CAD-проект</p>
                <p class="text-xs text-muted-on-ink mt-0.5">Моделирование схемы расстановки с расчётом ёмкости склада.</p>
              </div>
            </div>

            <div class="flex items-start gap-3.5 rounded-lg border border-line bg-paper p-4 shadow-xs">
              <span class="font-mono text-xs font-bold text-accent mt-0.5">02</span>
              <div>
                <p class="text-sm font-semibold text-ink">Соблюдение ГОСТ и СНиП</p>
                <p class="text-xs text-muted-on-ink mt-0.5">Все расчёты выполняются с учётом коэффициентов запаса прочности.</p>
              </div>
            </div>

            <div class="flex items-start gap-3.5 rounded-lg border border-line bg-paper p-4 shadow-xs">
              <span class="font-mono text-xs font-bold text-cyan mt-0.5">03</span>
              <div>
                <p class="text-sm font-semibold text-ink">Быстрый отклик в Telegram</p>
                <p class="text-xs text-muted-on-ink mt-0.5">
                  Нужен срочный ответ? <a href={SITE.socials.telegram} target="_blank" rel="noopener noreferrer" class="text-cyan font-semibold hover:underline">Напишите инженеру напрямую ↗</a>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Modernized QuoteForm -->
        <div class="lg:col-span-7">
          <QuoteForm lang={lang} />
        </div>
      </div>
    </section>

    <!-- 04 Related Catalog & Services Navigation -->
    <RelatedLinks
      lang={lang}
      kicker={t("page.related")}
      index={4}
      total={TOTAL}
      items={[
        { path: "/catalog/", label: t("nav.catalog") },
        { path: "/catalog/stellazhi/", label: t("nav.racks") },
        { path: "/services/", label: t("nav.services") },
        { path: "/about/", label: t("nav.about") },
      ]}
    />
  </article>
  <JsonLd data={localBusinessLd()} />
</BaseLayout>
