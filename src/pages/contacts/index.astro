---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import SectionMeta from "../../components/SectionMeta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACTS } from "../../data/company";
import { SITE } from "../../data/site";
import { useT } from "../../i18n/utils";

const lang = "ru" as const;
const t = useT(lang);
const TOTAL = 3;
const address = SITE.address.ru;
---

<BaseLayout title={CONTACTS.title} description={CONTACTS.description}>
  <article>
    <header class="page-head bg-paper" data-reveal>
      <div class="site-wrap">
        <Breadcrumbs
          lang={lang}
          items={[
            { label: t("crumb.home"), path: "/" },
            { label: t("nav.contacts") },
          ]}
        />
        <SectionMeta kicker={t("page.kickerCompany")} index={1} total={TOTAL} />
        <h1 class="t-display">{CONTACTS.h1}</h1>
        <p class="t-lead">{CONTACTS.lead}</p>
      </div>
    </header>

    <section class="section-y bg-paper" data-reveal>
      <div class="site-wrap grid gap-16 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SectionMeta kicker={t("nav.contacts")} index={2} total={TOTAL} />
          <div class="spec-list">
            <div class="spec-row">
              <p class="spec-key">{t("footer.phone")}</p>
              <p>
                <a class="text-link" href={`tel:${SITE.phone.tel}`}>{SITE.phone.display}</a>
              </p>
            </div>
            <div class="spec-row">
              <p class="spec-key">{t("contacts.mobiles")}</p>
              <p class="space-y-1">
                {
                  SITE.mobiles.map((item) => (
                    <a class="block text-link" href={`tel:${item.tel}`}>
                      {item.display}
                    </a>
                  ))
                }
              </p>
            </div>
            <div class="spec-row">
              <p class="spec-key">{t("footer.email")}</p>
              <p>
                <a class="text-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
              </p>
            </div>
            <div class="spec-row">
              <p class="spec-key">{t("contacts.hours")}</p>
              <p>
                {t("contacts.weekdays")}
                <br />
                {t("contacts.weekend")}
              </p>
            </div>
            <div class="spec-row">
              <p class="spec-key">{t("footer.address")}</p>
              <p>
                <a class="text-link" href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer">
                  {address}
                </a>
              </p>
            </div>
          </div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <a href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer" class="relative block aspect-[16/10] overflow-hidden bg-ink">
            <img
              src={SITE.mapsImage}
              alt=""
              class="photo-grade absolute inset-0 h-full w-full object-cover"
              width="1200"
              height="640"
              loading="lazy"
              decoding="async"
            />
          </a>
          <p class="mt-4">
            <a class="text-link" href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer">
              {t("cta.map")}
              <span class="link-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </p>
        </div>
      </div>
    </section>

    <section id="quote" class="section-y bg-paper" data-reveal>
      <div class="site-wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SectionMeta kicker={t("contacts.quote")} index={3} total={TOTAL} />
          <h2 class="t-display">{t("cta.quote")}</h2>
          <p class="t-lead">{t("form.note")}</p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <QuoteForm lang={lang} />
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
