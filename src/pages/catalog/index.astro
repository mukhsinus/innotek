---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PhotoFrame from "../../components/PhotoFrame.astro";
import QuoteBand from "../../components/QuoteBand.astro";
import SectionMeta from "../../components/SectionMeta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CATALOG_CATEGORIES } from "../../data/catalog";
import { CATALOG_HUB } from "../../data/company";
import { HOME } from "../../data/home";
import { hrefFor, useT } from "../../i18n/utils";

const lang = "ru" as const;
const t = useT(lang);
const pad = (n: number) => String(n).padStart(2, "0");
const TOTAL = 3;
---

<BaseLayout title={CATALOG_HUB.title} description={CATALOG_HUB.description}>
  <article>
    <header class="page-head bg-surface" data-reveal>
      <div class="site-wrap">
        <Breadcrumbs
          lang={lang}
          items={[
            { label: t("crumb.home"), path: "/" },
            { label: t("nav.catalog") },
          ]}
        />
        <SectionMeta kicker={t("nav.catalog")} index={1} total={TOTAL} />
        <h1 class="t-display">{CATALOG_HUB.h1}</h1>
        <p class="t-lead">{HOME.ru.catalogLead}</p>
      </div>
    </header>

    <section class="section-y bg-paper" data-reveal>
      <div class="site-wrap">
        <SectionMeta kicker={t("page.lineup")} index={2} total={TOTAL} />
        <div class="site-grid">
          {
            CATALOG_CATEGORIES.map((item, i) => (
              <a
                href={hrefFor(lang, item.path)}
                data-stagger
                class:list={[
                  "group col-span-4 block bg-paper p-1",
                  i === 0 ? "lg:col-span-8" : "lg:col-span-4",
                ]}
              >
                <div
                  class:list={[
                    "relative overflow-hidden bg-surface",
                    i === 0
                      ? "aspect-[16/10] lg:aspect-[16/9]"
                      : "aspect-[4/5]",
                  ]}
                >
                  <span class="bento-media" data-parallax>
                    <PhotoFrame
                      src={item.image}
                      width={800}
                      height={600}
                      loading={i === 0 ? "eager" : "lazy"}
                    />
                  </span>
                  <span class="bento-num">{pad(i + 1)}</span>
                </div>
                <h2
                  class="mt-4 text-lg font-medium tracking-[-0.02em] text-ink group-hover:text-accent transition-colors lg:text-xl"
                  style="font-family: var(--font-display)"
                >
                  {t(item.labelKey)}
                  <span class="link-arrow" aria-hidden="true">
                    {" "}
                    →
                  </span>
                </h2>
                <p class="mt-1.5 text-sm text-muted-on-ink">{item.lead}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <QuoteBand lang={lang} index={3} total={TOTAL} />
  </article>
</BaseLayout>
