---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CatalogCard from "../../components/CatalogCard.astro";
import QuoteBand from "../../components/QuoteBand.astro";
import SectionMeta from "../../components/SectionMeta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CATALOG_HUB } from "../../data/company";
import { HOME } from "../../data/home";
import { hrefFor, useT } from "../../i18n/utils";

const lang = "ru" as const;
const t = useT(lang);
const copy = HOME[lang];
const TOTAL = 3;
---

<BaseLayout title={CATALOG_HUB.title} description={CATALOG_HUB.description}>
  <article>
    <header class="page-head bg-surface" data-reveal>
      <div class="site-wrap">
        <Breadcrumbs
          lang={lang}
          items={[
            { label: t("crumb.home"), path: "/" },
            { label: t("nav.catalog") },
          ]}
        />
        <SectionMeta kicker={t("nav.catalog")} index={1} total={TOTAL} />
        <h1 class="t-display">{CATALOG_HUB.h1}</h1>
        <p class="t-lead">{copy.catalogLead}</p>
      </div>
    </header>

    <section class="section-y bg-paper" data-reveal>
      <div class="site-wrap">
        <SectionMeta kicker={t("page.lineup")} index={2} total={TOTAL} />
        
        <div class="catalog-grid mt-8">
          {
            copy.categories.map((cat, i) => (
              <CatalogCard
                href={hrefFor(lang, cat.path)}
                image={cat.image}
                title={t(cat.labelKey)}
                index={i + 1}
                kicker={i === 0 ? "Флагман" : undefined}
                heading="h2"
                loading={i < 3 ? "eager" : "lazy"}
              />
            ))
          }
        </div>
      </div>
    </section>

    <QuoteBand lang={lang} index={3} total={TOTAL} />
  </article>
</BaseLayout>
