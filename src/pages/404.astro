---
import SectionMeta from "../components/SectionMeta.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { currentLangFromPath, hrefFor, useT } from "../i18n/utils";

const lang = (Astro.currentLocale ?? currentLangFromPath(Astro.url.pathname)) as Lang;
const t = useT(lang);
---

<BaseLayout title={`${t("notFound.title")} | Innotek`} description={t("notFound.lead")}>
  <header class="page-head bg-paper">
    <div class="site-wrap">
      <SectionMeta kicker="404" index={1} total={1} />
      <h1 class="t-display">{t("notFound.title")}</h1>
      <p class="t-lead">{t("notFound.lead")}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a class="btn-primary" href={hrefFor(lang, "/")}>{t("notFound.home")}</a>
        <a class="btn-ghost border-ink" href={hrefFor(lang, "/catalog/")}>{t("cta.catalog")}</a>
      </div>
    </div>
  </header>
</BaseLayout>
