---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import QuoteBand from "../../components/QuoteBand.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import SectionMeta from "../../components/SectionMeta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { VIDEO } from "../../data/company";
import { useT } from "../../i18n/utils";

const lang = "ru" as const;
const t = useT(lang);
const TOTAL = 3;
---

<BaseLayout title={VIDEO.title} description={VIDEO.description}>
  <article>
    <header class="page-head bg-paper" data-reveal>
      <div class="site-wrap">
        <Breadcrumbs
          lang={lang}
          items={[
            { label: t("crumb.home"), path: "/" },
            { label: t("nav.video") },
          ]}
        />
        <SectionMeta kicker={t("page.kickerCompany")} index={1} total={TOTAL} />
        <h1 class="t-display">{VIDEO.h1}</h1>
        <p class="t-lead max-w-2xl">{VIDEO.lead}</p>
      </div>
    </header>

    <section class="section-y bg-paper" data-reveal>
      <div class="site-wrap">
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {
            VIDEO.videos.map((vid) => (
              <div class="flex flex-col overflow-hidden rounded-xl border border-ink/10 bg-surface shadow-sm">
                <div class="relative aspect-[9/16] w-full max-w-[320px] mx-auto overflow-hidden bg-ink/5 sm:aspect-video sm:max-w-none">
                  <iframe
                    src={vid.embedUrl}
                    title={vid.title}
                    class="h-full w-full border-0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    loading="lazy"
                  />
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">{vid.category}</span>
                  <h2 class="mt-2 text-xl font-bold text-ink">{vid.title}</h2>
                  <p class="mt-2 flex-1 text-sm text-muted">{vid.description}</p>
                  <div class="mt-6 pt-4 border-t border-ink/5">
                    <a
                      href={vid.watchUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center text-sm font-semibold text-accent hover:underline"
                    >
                      Смотреть на YouTube
                      <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <div class="mt-12 rounded-2xl bg-ink/5 p-8 text-center sm:p-12">
          <h3 class="text-2xl font-bold text-ink">Больше видео на нашем YouTube канале</h3>
          <p class="mt-2 text-muted">Подписывайтесь на канал @innotek_invest, чтобы следить за новыми проектами, производством и монтажом.</p>
          <a
            href={VIDEO.channelUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-accent mt-6 inline-flex items-center"
          >
            Перейти на YouTube @innotek_invest
            <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <RelatedLinks
      lang={lang}
      kicker={t("page.related")}
      index={2}
      total={TOTAL}
      items={[
        { path: "/catalog/", label: t("nav.catalog") },
        { path: "/services/", label: t("nav.services") },
        { path: "/about/", label: t("nav.about") },
      ]}
    />

    <QuoteBand lang={lang} index={3} total={TOTAL} />
  </article>
</BaseLayout>
