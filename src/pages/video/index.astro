---
import QuoteBand from "../../components/QuoteBand.astro";
import SectionMeta from "../../components/SectionMeta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { VIDEO } from "../../data/company";
import { HOME } from "../../data/home";
import { useT } from "../../i18n/utils";

const lang = "ru" as const;
const t = useT(lang);
const pad = (n: number) => String(n).padStart(2, "0");
const stills = HOME.ru.cases;
const TOTAL = 3;
---

<BaseLayout title={VIDEO.title} description={VIDEO.description}>
  <article>
    <header class="page-head bg-paper" data-reveal>
      <div class="site-wrap">
        <SectionMeta kicker={t("page.kickerCompany")} index={1} total={TOTAL} />
        <h1 class="t-display">{VIDEO.h1}</h1>
        <p class="t-lead">{VIDEO.lead}</p>
      </div>
    </header>

    <section class="section-y bg-paper" data-reveal>
      <div class="site-wrap">
        <SectionMeta kicker={t("page.stills")} index={2} total={TOTAL} />
        <div class="site-grid">
          {
            stills.map((item, i) => (
              <div
                class:list={[
                  "relative overflow-hidden bg-ink",
                  i === 0 ? "col-span-4 aspect-[16/10] lg:col-span-12 lg:aspect-[16/8]" : "col-span-4 aspect-[4/5] lg:col-span-6 lg:aspect-[16/10]",
                ]}
              >
                <img
                  src={item.image}
                  alt=""
                  class="photo-grade absolute inset-0 h-full w-full object-cover"
                  width={i === 0 ? 1200 : 800}
                  height={i === 0 ? 750 : 1000}
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
                <span class="bento-num">{pad(i + 1)}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <QuoteBand lang={lang} index={3} total={TOTAL} />
  </article>
</BaseLayout>
