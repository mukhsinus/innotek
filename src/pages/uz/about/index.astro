---
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PhotoFrame from "../../../components/PhotoFrame.astro";
import QuoteBand from "../../../components/QuoteBand.astro";
import RelatedLinks from "../../../components/RelatedLinks.astro";
import SectionMeta from "../../../components/SectionMeta.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ABOUT } from "../../../data/company";
import { useT } from "../../../i18n/utils";

const lang = "uz" as const;
const t = useT(lang);
const TOTAL = 5;

const STATS = [
  { value: "5", label: "Avtomatlashtirilgan liniya", desc: "Profillash, lazerli kesish va bukish" },
  { value: "0.2–6.0 mm", label: "Po'lat qalinligi", desc: "ST 37 konstruksion po'lati" },
  { value: "14 000 mm gacha", label: "Rama balandligi", desc: "Loyiha bo'yicha individual o'lchamlar" },
  { value: "4 500 kg gacha", label: "Yarus yuk ko'tarish", desc: "ISO 9001:2015 sertifikatlangan" },
];

const PILLARS = [
  {
    num: "01",
    tag: "LOYIHALASH",
    title: "Muhandislik hisob-kitobi va modellashtirish",
    desc: "O'zimizning konstruktorlik bo'limimiz italiyalik mutaxassislar ko'magida yuk taqsimoti, saqlash zichligi va seysmik barqarorlikni hisoblab chiqadi.",
  },
  {
    num: "02",
    tag: "ISHLAB CHIQARISH",
    title: "Toshkentda to'liq siklli zavod",
    desc: "Avtomatlashtirilgan prokat liniyalari, polimer kukunli bo'yash va metallga termik ishlov berish aniq geometriya va mustahkamlikni ta'minlaydi.",
  },
  {
    num: "03",
    tag: "O'RNATISH VA SERVIS",
    title: "GOST standartlari bo'yicha yig'ish",
    desc: "Malakali montaj brigadalari amaldagi ombor faoliyatini to'xtatmasdan qisqa muddatda stelaj tizimlarini o'rnatish va ta'mirlashni amalga oshiradi.",
  },
];
---

<BaseLayout title="Kompaniya haqida | Innotek" description="Ombor uskunalarini loyihalash va stelajlarni o'rnatish. Innotek jamoasi, Toshkent.">
  <article>
    <!-- Header -->
    <header class="page-head bg-surface" data-reveal>
      <div class="site-wrap">
        <Breadcrumbs
          lang={lang}
          items={[
            { label: t("crumb.home"), path: "/uz/" },
            { label: t("nav.about") },
          ]}
        />
        <SectionMeta kicker={t("page.kickerCompany")} index={1} total={TOTAL} />
        <h1 class="t-display">Kompaniya haqida</h1>
        <p class="t-lead">Kompaniyaning uzoq muddatli va mustahkam muvaffaqiyati to'g'ri falsafa va qadriyatlarga asoslanadi.</p>
      </div>
    </header>

    <!-- Main Factory Banner Photo -->
    <section class="bg-paper pb-0" data-reveal>
      <div class="site-wrap">
        <div class="relative aspect-[16/9] overflow-hidden rounded-xl border border-line bg-surface lg:aspect-[21/9] shadow-sm">
          <PhotoFrame
            src="/images/site_image_01.jpg"
            class="absolute inset-0 h-full w-full object-cover"
            width={1400}
            height={700}
            loading="eager"
            fetchpriority="high"
          />
          <span class="cad-cross cad-tl" aria-hidden="true">+</span>
          <span class="cad-cross cad-tr" aria-hidden="true">+</span>
          <span class="cad-cross cad-bl" aria-hidden="true">+</span>
          <span class="cad-cross cad-br" aria-hidden="true">+</span>
          <div class="absolute bottom-4 left-4 z-10 hidden sm:block">
            <div class="telemetry-pill">
              <span class="relative flex h-1.5 w-1.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan opacity-75"></span>
                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-cyan"></span>
              </span>
              <span>INNOTEK PLANT // TASHKENT</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Principles & Pillars -->
    <section class="section-y bg-paper" data-reveal>
      <div class="site-wrap">
        <SectionMeta kicker="BIZNING YONDASHUV" index={2} total={TOTAL} />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
          {
            PILLARS.map((p, i) => (
              <div
                data-stagger
                style={`--stagger: ${i}`}
                class="group relative flex flex-col justify-between overflow-hidden rounded-xl border border-line bg-surface/80 p-6 sm:p-8 transition-all duration-300 hover:border-accent/50 hover:bg-surface hover:shadow-lg"
              >
                <span class="cad-cross cad-tl" aria-hidden="true">+</span>
                <span class="cad-cross cad-tr" aria-hidden="true">+</span>
                <span class="cad-cross cad-bl" aria-hidden="true">+</span>
                <span class="cad-cross cad-br" aria-hidden="true">+</span>

                <div>
                  <div class="flex items-center justify-between mb-6">
                    <span class="font-mono text-xs font-semibold text-cyan tracking-wider">
                      {p.num} // {p.tag}
                    </span>
                  </div>
                  <h2 class="text-xl font-display font-semibold text-ink group-hover:text-accent transition-colors mb-3">
                    {p.title}
                  </h2>
                  <p class="text-sm leading-relaxed text-muted-on-ink">
                    {p.desc}
                  </p>
                </div>

                <span class="absolute left-0 top-0 bottom-0 w-[3px] bg-accent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Engineering Stats -->
    <section class="section-y bg-surface border-y border-line" data-reveal>
      <div class="site-wrap">
        <SectionMeta kicker="ISHLAB CHIQARISH KO'RSATKICHLARI" index={3} total={TOTAL} />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mt-10">
          {
            STATS.map((stat, i) => (
              <div class="border-l-2 border-accent pl-5" data-stagger style={`--stagger: ${i}`}>
                <p class="text-3xl lg:text-4xl font-display font-bold text-ink tracking-tight">
                  {stat.value}
                </p>
                <p class="mt-2 text-sm font-semibold text-ink">
                  {stat.label}
                </p>
                <p class="mt-1 text-xs text-muted-on-ink">
                  {stat.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Clients Section -->
    <section class="section-y bg-paper" data-reveal>
      <div class="site-wrap">
        <SectionMeta kicker={t("page.clients")} index={4} total={TOTAL} />
        <div class="mt-8 overflow-hidden rounded-xl border border-line">
          <ul class="client-logos">
            {
              ABOUT.clients.map((item) => (
                <li>
                  <img
                    src={item.src?.startsWith("/src/assets/images/") ? item.src.replace("/src/assets/images/", "/images/") : item.src}
                    alt={item.alt}
                    width="160"
                    height="64"
                    loading="lazy"
                    decoding="async"
                  />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Related Links -->
    <RelatedLinks
      lang={lang}
      kicker={t("page.related")}
      index={5}
      total={TOTAL}
      items={[
        { path: "/services/proektirovanie/", label: t("service.design") },
        { path: "/services/montazh-demontazh/", label: t("service.install") },
        { path: "/catalog/", label: t("nav.catalog") },
        { path: "/services/", label: t("nav.services") },
      ]}
    />

    <!-- Quote Band -->
    <QuoteBand lang={lang} index={5} total={TOTAL} />
  </article>
</BaseLayout>
