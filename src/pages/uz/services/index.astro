---
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PhotoFrame from "../../../components/PhotoFrame.astro";
import QuoteBand from "../../../components/QuoteBand.astro";
import SectionMeta from "../../../components/SectionMeta.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SERVICES } from "../../../data/services";
import { hrefFor, useT } from "../../../i18n/utils";

const lang = "uz" as const;
const t = useT(lang);
const pad = (n: number) => String(n).padStart(2, "0");
const TOTAL = 4;

const PILLARS_UZ = [
  {
    num: "01",
    title: "Attestatsiyadan o'tgan brigada",
    desc: "Balandlikda ishlash ruxsatiga va 10 yildan ortiq tajribaga ega muhandislar va montajchilar.",
  },
  {
    num: "02",
    title: "Zavod standartlari",
    desc: "Xususiy tayyorlov, tozalash va polimer bo'yash uskunalari.",
  },
  {
    num: "03",
    title: "GOST va kafolat",
    desc: "Xavfsizlik me'yorlariga qat'iy rioya qilgan holda loyihalash va montaj, rasmiy kafolat.",
  },
];
---

<BaseLayout title={`${t("nav.services")} | Innotek`} description={t("services.lead")}>
  <article>
    <!-- Header -->
    <header class="page-head bg-surface" data-reveal>
      <div class="site-wrap">
        <Breadcrumbs
          lang={lang}
          items={[
            { label: t("crumb.home"), path: "/" },
            { label: t("nav.services") },
          ]}
        />
        <div class="flex flex-wrap items-center justify-between gap-4 mt-2 mb-4">
          <SectionMeta kicker={t("page.kickerService")} index={1} total={TOTAL} />
          <div class="telemetry-pill" aria-label="Status">
            <span class="relative flex h-1.5 w-1.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan opacity-75"></span>
              <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-cyan"></span>
            </span>
            <span>ENGINEERING & INDUSTRIAL SERVICES</span>
          </div>
        </div>
        <h1 class="t-display">{t("nav.services")}</h1>
        <p class="t-lead max-w-3xl">{t("services.lead")}</p>
      </div>
    </header>

    <!-- Services Bento Lineup -->
    <section class="section-y bg-paper" data-reveal>
      <div class="site-wrap">
        <SectionMeta kicker={t("page.lineup")} index={2} total={TOTAL} />

        <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            SERVICES.map((item, i) => (
              <a
                href={hrefFor(lang, item.path)}
                data-spotlight
                style={`--stagger: ${i}`}
                class="group relative flex flex-col justify-between overflow-hidden rounded-xl border border-line bg-surface/70 p-5 sm:p-6 transition-all duration-300 hover:border-accent/50 hover:bg-surface hover:shadow-xl"
              >
                <!-- Blueprint corner crosshairs -->
                <span class="cad-cross cad-tl" aria-hidden="true">+</span>
                <span class="cad-cross cad-tr" aria-hidden="true">+</span>
                <span class="cad-cross cad-bl" aria-hidden="true">+</span>
                <span class="cad-cross cad-br" aria-hidden="true">+</span>

                <!-- Top metadata & arrow pill -->
                <div class="relative z-10 flex items-center justify-between gap-4">
                  <span class="font-mono text-xs font-semibold text-cyan tracking-wider uppercase">
                    {pad(i + 1)} // {item.slug.toUpperCase()}
                  </span>
                  <span class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-line bg-paper text-muted-on-ink group-hover:border-accent group-hover:text-accent group-hover:translate-x-1 transition-all duration-300 shadow-xs">
                    →
                  </span>
                </div>

                <!-- Visual Media Container -->
                <div class="relative my-6 aspect-[16/9] overflow-hidden rounded-lg bg-paper/60 p-2 transition-all duration-500 group-hover:bg-paper">
                  <div class="relative h-full w-full overflow-hidden rounded">
                    <PhotoFrame
                      src={item.image}
                      class="h-full w-full object-cover filter contrast-[1.02] brightness-[0.98] transition-transform duration-500 group-hover:scale-105"
                      width={800}
                      height={450}
                      loading={i < 2 ? "eager" : "lazy"}
                    />
                  </div>
                  {item.tag?.uz && (
                    <span class="absolute bottom-4 left-4 z-10 inline-block rounded border border-line/80 bg-paper/90 backdrop-blur-sm px-2.5 py-1 font-mono text-[11px] font-semibold text-ink shadow-xs">
                      {item.tag.uz}
                    </span>
                  )}
                </div>

                <!-- Bottom Content -->
                <div class="relative z-10 pt-1">
                  <h2 class="font-display text-xl font-semibold tracking-tight text-ink group-hover:text-accent transition-colors sm:text-2xl">
                    {t(item.labelKey)}
                  </h2>
                  <p class="mt-2 text-sm leading-relaxed text-muted-on-ink">
                    {item.lead}
                  </p>
                </div>

                <!-- Left Orange Accent Strip on Hover -->
                <span class="absolute left-0 top-0 bottom-0 w-[3px] bg-accent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Technical Pillars / Advantages -->
    <section class="section-y bg-surface border-y border-line" data-reveal>
      <div class="site-wrap">
        <SectionMeta kicker="MUHANDISLIK STANDARTLARI" index={3} total={TOTAL} />
        <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
          {
            PILLARS_UZ.map((p) => (
              <div class="relative rounded-xl border border-line bg-paper p-6 sm:p-8 shadow-xs">
                <span class="font-mono text-xs font-bold text-cyan">{p.num}</span>
                <h3 class="mt-3 font-display text-lg font-semibold text-ink">{p.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-on-ink">{p.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Unified QuoteBand -->
    <QuoteBand lang={lang} index={4} total={TOTAL} />
  </article>
</BaseLayout>
