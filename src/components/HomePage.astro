---
import "../styles/home.css";
import RackAssembly3D from "./RackAssembly3D.astro";
import SectionMeta from "./SectionMeta.astro";
import { HOME, HOME_STATS } from "../data/home";
import { SITE } from "../data/site";
import type { Lang } from "../i18n/ui";
import { hrefFor, useT } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const copy = HOME[lang];
const quoteHref = `${hrefFor(lang, "/contacts/")}#quote`;
const catalogHref = hrefFor(lang, "/catalog/");
const videoHref = hrefFor(lang, "/video/");
const isUz = lang === "uz";
const address = isUz ? SITE.address.uz : SITE.address.ru;
const heroLines = copy.h1.split("\n");
const marquee = copy.marquee.repeat(4);
const pad = (n: number) => String(n).padStart(2, "0");
const SECTIONS = 6;
const img = (src: string) => (src?.startsWith("/src/assets/images/") ? src.replace("/src/assets/images/", "/images/") : src);
---

<!-- 01 Hero: static, confident, blueprint grid accent -->
<section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-paper text-ink">
  <img
    src={img(copy.heroImage)}
    alt=""
    class="hero-photo absolute inset-0 h-full w-full object-cover"
    width="1600"
    height="1000"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="absolute inset-0 z-[1] bg-paper/50"></div>
  <div class="absolute inset-0 z-[1] bg-gradient-to-t from-paper via-paper/70 to-transparent"></div>
  <div class="home-noise" aria-hidden="true"></div>
  <div class="site-wrap relative z-10 pt-36 pb-20 lg:pb-24">
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <p class="t-overline">01 / {pad(SECTIONS)}</p>
      <div class="telemetry-pill" aria-label="System status">
        <span class="relative flex h-1.5 w-1.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan opacity-75"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-cyan"></span>
        </span>
        <span>PRODUCTION // TASHKENT</span>
      </div>
    </div>
    <div class="max-w-5xl">
      <h1 class="t-display">
        {
          heroLines.map((line, i) => (
            <span class="hero-line" style={`--i: ${i}`}>
              <span class="hero-line-inner">{line}</span>
            </span>
          ))
        }
      </h1>
      <p class="hero-lead t-lead">{copy.heroLead}</p>
      <div class="hero-actions mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a class="btn-accent" href={quoteHref}>{t("cta.quote")}</a>
        <a class="text-link" href={catalogHref}>
          {t("cta.catalog")}
          <span class="link-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
  <p class="hero-stick">{t("home.heroStick")}</p>
  <div class="hero-scroll" aria-hidden="true">
    <span class="hero-scroll-line"></span>
  </div>
</section>

<!-- 02 Interactive 3D Scroll Assembly Sequence -->
<RackAssembly3D lang={lang} index={2} total={SECTIONS} />

<!-- 03 Catalog: Modern Engineered Bento Grid -->
<section id="catalog" class="section-y bg-paper" data-reveal>
  <div class="site-wrap">
    <SectionMeta kicker={t("home.kickerCatalog")} index={3} total={SECTIONS} />
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 lg:mb-16">
      <div>
        <h2 class="t-display">
          {copy.catalogHeading.before}
          <span class="t-stroke">{copy.catalogHeading.accent}</span>
        </h2>
        <p class="t-lead">{copy.catalogLead}</p>
      </div>
      <a class="text-link self-start md:self-end pb-1 font-mono text-xs text-cyan hover:text-accent" href={catalogHref}>
        <span>[ {isUz ? "BARCHA MAHSULOTLAR" : "ВЕСЬ КАТАЛОГ ПРОДУКЦИИ"} ]</span>
        <span class="link-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- 12-Column Responsive Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 lg:gap-6">
      {
        copy.categories.map((cat, i) => {
          let spanClass = "col-span-12 md:col-span-6 lg:col-span-4";
          let heightClass = "h-44 sm:h-48";
          let titleSize = "text-xl sm:text-2xl";

          if (i === 0) {
            spanClass = "col-span-12 lg:col-span-8";
            heightClass = "h-56 sm:h-64 lg:h-72";
            titleSize = "text-2xl sm:text-3xl";
          } else if (i === 1) {
            spanClass = "col-span-12 md:col-span-6 lg:col-span-4";
          } else if (i === 5 || i === 6) {
            spanClass = "col-span-12 md:col-span-6 lg:col-span-6";
          }

          return (
            <a
              href={hrefFor(lang, cat.path)}
              data-stagger
              data-spotlight
              style={`--stagger: ${i}`}
              class:list={[
                "group relative flex flex-col justify-between overflow-hidden rounded-xl border border-line bg-surface/70 p-6 sm:p-7 transition-all duration-300 hover:border-accent/50 hover:bg-surface hover:shadow-lg",
                spanClass,
              ]}
            >
              <span class="cad-cross cad-tl" aria-hidden="true">+</span>
              <span class="cad-cross cad-tr" aria-hidden="true">+</span>
              <span class="cad-cross cad-bl" aria-hidden="true">+</span>
              <span class="cad-cross cad-br" aria-hidden="true">+</span>

              <!-- Top index & arrow pill -->
              <div class="relative z-10 flex items-center justify-between">
                <span class="font-mono text-xs font-semibold text-cyan tracking-wider">
                  {pad(i + 1)} // {i === 0 ? (isUz ? "FLAGMAN" : "ФЛАГМАН") : (isUz ? "KATEGORIYA" : "КАТЕГОРИЯ")}
                </span>
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-line bg-paper text-muted-on-ink group-hover:border-accent group-hover:text-accent group-hover:translate-x-1 transition-all duration-300 shadow-xs">
                  →
                </span>
              </div>

              <!-- Product Visual Container (Clean crisp image, no washout) -->
              <div class:list={[
                "relative my-5 flex items-center justify-center overflow-hidden rounded-lg bg-paper/60 p-4 transition-all duration-500 group-hover:bg-paper",
                heightClass,
              ]}>
                <img
                  src={img(cat.image)}
                  alt={t(cat.labelKey)}
                  class="h-full w-full object-contain filter contrast-[1.03] brightness-[0.98] transition-transform duration-500 group-hover:scale-105"
                  width="600"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <!-- Bottom Category Title -->
              <div class="relative z-10 pt-1">
                <h3 class:list={[
                  "font-display font-semibold tracking-tight text-ink group-hover:text-accent transition-colors",
                  titleSize,
                ]}>
                  {t(cat.labelKey)}
                </h3>
              </div>

              <!-- Left Orange Accent Strip on Hover -->
              <span class="absolute left-0 top-0 bottom-0 w-[3px] bg-accent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<!-- 04 Production stats -->
<section id="production" class="section-y bg-paper" data-reveal>
  <div class="site-wrap">
    <SectionMeta kicker={t("home.kickerProduction")} index={4} total={SECTIONS} />
    <h2 class="t-display">
      {copy.productionHeading.before}
      <span class="t-stroke">{copy.productionHeading.accent}</span>
    </h2>
    <p class="t-lead">{copy.productionLead}</p>

    <!-- 3 High-End Telemetry Stat Cards -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 mt-12 lg:mt-16">
      <!-- Card 1: Experience -->
      <div class="stat-card group" data-stagger data-spotlight style="--stagger: 0">
        <span class="cad-cross cad-tl" aria-hidden="true">+</span>
        <span class="cad-cross cad-tr" aria-hidden="true">+</span>
        <span class="cad-cross cad-bl" aria-hidden="true">+</span>
        <span class="cad-cross cad-br" aria-hidden="true">+</span>

        <p class="text-xs font-mono text-cyan tracking-wider font-semibold mb-4">
          01 // {isUz ? "TAJRIBA VA KO'LAM" : "ОПЫТ И МАСШТАБ"}
        </p>
        <p class="stat-num">
          <span data-count={HOME_STATS.years}>{HOME_STATS.years}</span><span class="text-accent text-3xl lg:text-4xl ml-1 font-mono font-light">+</span>
        </p>
        <p class="text-base font-semibold text-ink mt-3" style="font-family: var(--font-display)">
          {isUz ? "Yillik bozor tajribasi" : "Лет на рынке стеллажей"}
        </p>
        <p class="text-xs text-muted-on-ink mt-1.5 leading-relaxed">
          {isUz ? "O'zbekiston va MDH bo'ylab yirik ombor hamda logistika komplekslarini loyihalash." : "Проектирование и оснащение складских комплексов по всему Узбекистану и СНГ."}
        </p>
      </div>

      <!-- Card 2: Production Lines -->
      <div class="stat-card group" data-stagger data-spotlight style="--stagger: 1">
        <span class="cad-cross cad-tl" aria-hidden="true">+</span>
        <span class="cad-cross cad-tr" aria-hidden="true">+</span>
        <span class="cad-cross cad-bl" aria-hidden="true">+</span>
        <span class="cad-cross cad-br" aria-hidden="true">+</span>

        <p class="text-xs font-mono text-cyan tracking-wider font-semibold mb-4">
          02 // {isUz ? "AVTOMATIZATSIYA" : "АВТОМАТИЗАЦИЯ"}
        </p>
        <p class="stat-num">
          <span data-count={HOME_STATS.lines}>{HOME_STATS.lines}</span>
        </p>
        <p class="text-base font-semibold text-ink mt-3" style="font-family: var(--font-display)">
          {isUz ? "Avtomatik ishlab chiqarish liniyalari" : "Автоматических прокатных линий"}
        </p>
        <p class="text-xs text-muted-on-ink mt-1.5 leading-relaxed">
          {isUz ? "Geometriyani yuqori aniqlikdagi CNC nazorati bilan uzluksiz sovuq prokat davri." : "Непрерывный цикл профилирования с высокоточным ЧПУ-контролем геометрии стоек и балок."}
        </p>
      </div>

      <!-- Card 3: Steel Thickness -->
      <div class="stat-card group sm:col-span-2 lg:col-span-1" data-stagger data-spotlight style="--stagger: 2">
        <span class="cad-cross cad-tl" aria-hidden="true">+</span>
        <span class="cad-cross cad-tr" aria-hidden="true">+</span>
        <span class="cad-cross cad-bl" aria-hidden="true">+</span>
        <span class="cad-cross cad-br" aria-hidden="true">+</span>

        <p class="text-xs font-mono text-cyan tracking-wider font-semibold mb-4">
          03 // {isUz ? "PO'LAT STANDARTI" : "СТАНДАРТ СТАЛИ"}
        </p>
        <p class="stat-num stat-num-long">
          <span data-count-range="0.2,6" data-format="{0}–{1}">{HOME_STATS.thickness}</span>
          <span class="text-muted-on-ink text-xl lg:text-2xl ml-1 font-mono font-normal">мм</span>
        </p>
        <p class="text-base font-semibold text-ink mt-3" style="font-family: var(--font-display)">
          {isUz ? "Konstruksion po'lat qalinligi" : "Толщина конструкционной стали"}
        </p>
        <p class="text-xs text-muted-on-ink mt-1.5 leading-relaxed">
          {isUz ? "Kukunli-polimer qoplamali GOST talablariga mos sovuq prokat po'lat." : "Холоднокатаная листовая сталь ГОСТ с антикоррозийной полимерно-порошковой окраской."}
        </p>
      </div>
    </div>

    <!-- Factory Highlights Ribbon -->
    <div class="mt-8 grid grid-cols-1 gap-4 border-t border-line/80 pt-8 sm:grid-cols-3">
      <div class="flex items-center gap-3 text-xs font-mono text-muted-on-ink">
        <span class="text-accent font-bold">✓</span>
        <span>{isUz ? "Oylik quvvat: 500+ tonna po'lat" : "Производственная мощность: 500+ т/мес"}</span>
      </div>
      <div class="flex items-center gap-3 text-xs font-mono text-muted-on-ink">
        <span class="text-accent font-bold">✓</span>
        <span>{isUz ? "ISO 9001:2015 sifat nazorati" : "Сертификация качества ISO 9001:2015"}</span>
      </div>
      <div class="flex items-center gap-3 text-xs font-mono text-muted-on-ink">
        <span class="text-accent font-bold">✓</span>
        <span>{isUz ? "Toshkentdagi o'z zavodimiz" : "Собственный завод и склад в Ташкенте"}</span>
      </div>
    </div>
  </div>
</section>

<!-- 05 Cases -->
<section id="cases" class="section-y bg-surface" data-reveal>
  <div class="site-wrap">
    <SectionMeta kicker={t("home.kickerCases")} index={5} total={SECTIONS} />
    <h2 class="t-display">
      {copy.casesHeading.before}
      <span class="t-stroke">{copy.casesHeading.accent}</span>
    </h2>
    <p class="t-lead">{copy.casesLead}</p>

    <!-- Modern Fresh Case Cards Grid -->
    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:mt-16">
      {
        copy.cases.map((item, i) => (
          <a
            href={videoHref}
            class="group relative flex flex-col justify-between overflow-hidden rounded-xl border border-line bg-paper p-6 sm:p-7 shadow-xs transition-all duration-300 hover:border-accent/50 hover:shadow-lg"
            data-stagger
            data-spotlight
            style={`--stagger: ${i}`}
          >
            <span class="cad-cross cad-tl" aria-hidden="true">+</span>
            <span class="cad-cross cad-tr" aria-hidden="true">+</span>
            <span class="cad-cross cad-bl" aria-hidden="true">+</span>
            <span class="cad-cross cad-br" aria-hidden="true">+</span>

            <!-- Top Index & Arrow -->
            <div class="relative z-10 flex items-center justify-between">
              <span class="font-mono text-xs font-semibold text-cyan tracking-wider">
                {pad(i + 1)} //
              </span>
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-line bg-surface text-muted-on-ink transition-all duration-300 group-hover:border-accent group-hover:text-accent group-hover:translate-x-1 shadow-xs">
                →
              </span>
            </div>

            <!-- Product Visual Container -->
            <div class="relative my-5 flex aspect-[4/3] items-center justify-center overflow-hidden rounded-lg bg-surface/60 p-4 transition-all duration-500 group-hover:bg-surface">
              <img
                src={img(item.image)}
                alt={t(item.labelKey)}
                class="h-full w-full object-contain filter contrast-[1.03] brightness-[0.98] transition-transform duration-500 group-hover:scale-106"
                width="600"
                height="450"
                loading="lazy"
                decoding="async"
              />
            </div>

            <!-- Bottom Label -->
            <div class="relative z-10 pt-1">
              <p class="font-display text-lg font-semibold tracking-tight text-ink transition-colors group-hover:text-accent">
                {t(item.labelKey)}
              </p>
            </div>

            <!-- Left Orange Accent Line on Hover -->
            <span class="absolute left-0 top-0 bottom-0 w-[3px] bg-accent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></span>
          </a>
        ))
      }
    </div>

    <div class="mt-12 lg:mt-16">
      <a class="btn-accent" href={videoHref}>{t("cta.video")}</a>
    </div>
  </div>
</section>

<!-- 06 CTA -->
<section id="quote" class="section-y relative isolate overflow-hidden bg-paper" data-reveal>
  <div class="cta-marquee" aria-hidden="true">
    <div class="cta-marquee-track">
      <span>{marquee}</span>
      <span>{marquee}</span>
    </div>
  </div>
  <div class="home-noise" aria-hidden="true"></div>
  
  <div class="cta-content site-wrap">
    <div
      data-spotlight
      class="group relative rounded-xl border border-line bg-surface/70 backdrop-blur-md p-8 sm:p-12 lg:p-16 shadow-[0_20px_50px_-20px_rgba(0,0,0,0.06)]"
    >
      <span class="cad-cross cad-tl" aria-hidden="true">+</span>
      <span class="cad-cross cad-tr" aria-hidden="true">+</span>
      <span class="cad-cross cad-bl" aria-hidden="true">+</span>
      <span class="cad-cross cad-br" aria-hidden="true">+</span>

      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <SectionMeta kicker={t("home.kickerCta")} index={6} total={SECTIONS} />
        <div class="telemetry-pill" aria-label="Status">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-cyan"></span>
          </span>
          <span>RAPID CAD SPECIFICATION // 24H</span>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">
        <!-- Left details & value proposition -->
        <div class="lg:col-span-7">
          <h2 class="t-display">
            {copy.ctaHeading.before}
            <span class="t-stroke">{copy.ctaHeading.accent}</span>
          </h2>
          <p class="t-lead text-base lg:text-lg mt-4 max-w-xl text-muted-on-ink leading-relaxed">
            {copy.ctaLead}
          </p>
        </div>

        <!-- Right Action Hub Card -->
        <div class="lg:col-span-5">
          <div class="rounded-lg border border-line bg-paper p-6 sm:p-8 shadow-sm">
            <p class="text-xs font-mono text-cyan tracking-wider uppercase mb-2">
              [ {isUz ? "Bog'lanish va narx" : "Расчёт стоимости"} ]
            </p>
            <p class="text-lg font-semibold text-ink" style="font-family: var(--font-display)">
              {isUz ? "Mutaxassis bilan bog'laning" : "Свяжитесь с инженером проекта"}
            </p>
            <p class="text-xs text-muted-on-ink mt-1 mb-6">
              {isUz ? "Sizga mos konfiguratsiyani tanlashda yordam beramiz." : "Ответим на вопросы и подготовим коммерческое предложение."}
            </p>

            <div class="space-y-3">
              <a
                class="btn-accent w-full justify-center text-center shadow-md hover:shadow-accent/25 transition-all"
                href={quoteHref}
              >
                <span>{t("cta.quote")}</span>
                <span class="link-arrow" aria-hidden="true">→</span>
              </a>

              <a
                class="btn-primary w-full justify-center text-center gap-2.5 hover:border-cyan hover:text-cyan transition-colors"
                href={SITE.socials.telegram}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .37z"/>
                </svg>
                <span>{isUz ? "Telegram orqali yozish" : "Написать в Telegram"}</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Contacts Strip inside the card -->
      <div class="mt-10 pt-8 border-t border-line/80 flex flex-col gap-4 text-xs font-mono text-muted-on-ink sm:flex-row sm:items-center sm:justify-between">
        <p class="truncate max-w-md">{address}</p>
        <div class="flex flex-wrap items-center gap-6">
          <a
            class="text-cyan hover:text-accent transition-colors inline-flex items-center gap-1"
            href={SITE.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>[41.3300° N, 69.2501° E]</span>
            <span aria-hidden="true">↗</span>
          </a>
          <a
            class="text-ink font-semibold hover:text-accent transition-colors text-sm"
            href={`tel:${SITE.phone.tel}`}
          >
            {SITE.phone.display}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

