---
import { SITE } from "../data/site";
import type { Lang } from "../i18n/ui";
import { useT } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<div class="pointer-events-none fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-40 flex flex-col gap-2 md:hidden">
  <a
    class="pointer-events-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#229ed9] text-white shadow-lg"
    href={SITE.socials.telegram}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t("fab.telegram")}
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M21.5 3.4 18.2 20c-.25 1.1-.9 1.37-1.82.85l-5.04-3.72-2.43 2.34c-.27.27-.5.5-.1.98l.18.12 6.4-3.6c.7-.4 1.34-.18 1.62-.67L22.4 4.7c.4-.95-.2-1.4-1-.98L3.7 10.6c-1 .38-.98.9-.17 1.14l4.4 1.37 10.2-6.42c.48-.3.92-.14.56.18Z"></path>
    </svg>
  </a>
  <a
    class="pointer-events-auto flex h-12 w-12 items-center justify-center rounded-full bg-accent-ink text-white shadow-lg"
    href={`tel:${SITE.phone.tel}`}
    aria-label={`${t("fab.call")}: ${SITE.phone.display}`}
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 5.5c0 8.3 6.7 15 15 15h1.2a2 2 0 0 0 2-1.7l.4-2.2a1 1 0 0 0-1.1-1.2l-3.2.6a1 1 0 0 1-1-.4l-1.4-1.9a12.1 12.1 0 0 1-3.7-3.7L9.1 8.6a1 1 0 0 1-.4-1L9.3 4.4A1 1 0 0 0 8.1 3.3L5.9 3.7a2 2 0 0 0-1.7 2v.6Z"></path>
    </svg>
  </a>
</div>
