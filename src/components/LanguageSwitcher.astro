---
import { languages, type Lang } from "../i18n/ui";
import { switchLocalePath, useT } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const pathname = Astro.url.pathname;
---

<div class="lang-switch inline-flex items-center gap-1 text-xs font-semibold tracking-[0.14em]" role="group" aria-label={t("lang.label")}>
  {
    (Object.keys(languages) as Lang[]).map((code) => {
      const href = switchLocalePath(code, pathname);
      const current = code === lang;
      return (
        <a
          href={href}
          hreflang={code === "ru" ? "ru-RU" : "uz-UZ"}
          aria-current={current ? "true" : undefined}
          class:list={[
            "rounded-sm px-2 py-1 transition-opacity",
            current ? "opacity-100" : "opacity-55 hover:opacity-100",
          ]}
        >
          {languages[code]}
        </a>
      );
    })
  }
</div>
