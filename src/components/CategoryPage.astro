---
import Breadcrumbs from "./Breadcrumbs.astro";
import PhotoFrame from "./PhotoFrame.astro";
import QuoteBand from "./QuoteBand.astro";
import QuoteSection from "./QuoteSection.astro";
import RelatedLinks from "./RelatedLinks.astro";
import SectionMeta from "./SectionMeta.astro";
import { CATALOG_CATEGORIES, type CatalogCategory } from "../data/catalog";
import type { Lang } from "../i18n/ui";
import { hrefFor, useT } from "../i18n/utils";

interface Props {
  lang: Lang;
  category: CatalogCategory;
}

const { lang, category } = Astro.props;
const t = useT(lang);
const pad = (n: number) => String(n).padStart(2, "0");
const img = (src?: string) => {
  if (!src) return "";
  let clean = src
    .replace("/src/assets/images/", "/images/")
    .replace("/imagesWebp/", "/images/");
  if (!clean.startsWith("/images/")) {
    clean = clean.startsWith("/") ? `/images${clean}` : `/images/${clean}`;
  }
  if (clean.endsWith(".webp")) {
    if (clean.includes("126081112") || clean.includes("23-300x200") || clean.includes("pris") || clean.includes("prs3") || clean.includes("photo_2023-09-27")) {
      // keep actual webp file
    } else if (clean.includes("rolik") || clean.includes("33") || clean.includes("kabel_3") || clean.includes("16-2")) {
      clean = clean.replace(/\.webp$/, ".png");
    } else {
      clean = clean.replace(/\.webp$/, ".jpg");
    }
  }
  return clean;
};
const hasGrid = category.products.length > 0;
const hasDetails = Boolean(
  category.body?.length || category.aiBody?.length || category.specs?.length || category.features?.length,
);
const hasSeo = Boolean(category.seo);
const related = CATALOG_CATEGORIES.filter((item) => item.slug !== category.slug).map((item) => ({
  path: item.path,
  label: t(item.labelKey),
}));
const TOTAL = 2 + (hasGrid ? 1 : 0) + (hasDetails ? 1 : 0) + (related.length ? 1 : 0) + (hasSeo ? 1 : 0);
let n = 1;
const introN = n++;
const gridN = hasGrid ? n++ : 0;
const detailsN = hasDetails ? n++ : 0;
const relatedN = related.length ? n++ : 0;
const ctaN = n++;
const seoN = hasSeo ? n++ : 0;
---

<article>
  <!-- Category Header -->
  <header class="page-head bg-surface" data-reveal>
    <div class="site-wrap">
      <Breadcrumbs
        lang={lang}
        items={[
          { label: t("crumb.home"), path: "/" },
          { label: t("nav.catalog"), path: "/catalog/" },
          { label: t(category.labelKey) },
        ]}
      />
      <SectionMeta kicker={t("nav.catalog")} index={introN} total={TOTAL} />
      <h1 class="t-display">{category.h1}</h1>
      <p class="t-lead">{category.lead}</p>
    </div>
  </header>

  <!-- Product Lineup (Engineered Bento Grid) -->
  {
    hasGrid && (
      <section class="section-y bg-paper" data-reveal>
        <div class="site-wrap">
          <SectionMeta kicker={t("page.lineup")} index={gridN} total={TOTAL} />
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
            {category.products.map((item, i) => (
              <a
                href={hrefFor(lang, item.path)}
                data-stagger
                data-spotlight
                style={`--stagger: ${i}`}
                class="group relative flex flex-col justify-between overflow-hidden rounded-xl border border-line bg-surface/70 p-6 sm:p-7 transition-all duration-300 hover:border-accent/50 hover:bg-surface hover:shadow-lg"
              >
                <span class="cad-cross cad-tl" aria-hidden="true">+</span>
                <span class="cad-cross cad-tr" aria-hidden="true">+</span>
                <span class="cad-cross cad-bl" aria-hidden="true">+</span>
                <span class="cad-cross cad-br" aria-hidden="true">+</span>

                <!-- Top index & arrow pill -->
                <div class="relative z-10 flex items-center justify-between">
                  <span class="font-mono text-xs font-semibold text-cyan tracking-wider">
                    {pad(i + 1)} // {category.slug.toUpperCase()}
                  </span>
                  <span class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-line bg-paper text-muted-on-ink group-hover:border-accent group-hover:text-accent group-hover:translate-x-1 transition-all duration-300 shadow-xs">
                    →
                  </span>
                </div>

                <!-- Product Visual Container -->
                <div class="relative my-5 flex items-center justify-center overflow-hidden rounded-lg bg-paper/60 p-4 h-52 sm:h-56 transition-all duration-500 group-hover:bg-paper">
                  <PhotoFrame
                    src={item.image}
                    class="h-full w-full object-contain filter contrast-[1.03] brightness-[0.98] transition-transform duration-500 group-hover:scale-105"
                    width={600}
                    height={400}
                    loading={i < 3 ? "eager" : "lazy"}
                  />
                </div>

                <!-- Bottom Product Title & Excerpt -->
                <div class="relative z-10 pt-1">
                  <h2 class="font-display text-xl font-semibold tracking-tight text-ink group-hover:text-accent transition-colors">
                    {t(item.labelKey)}
                  </h2>
                  {item.excerpt ? (
                    <p class="mt-2 text-xs leading-relaxed text-muted-on-ink line-clamp-2">
                      {item.excerpt}
                    </p>
                  ) : null}
                </div>

                <!-- Left Orange Accent Strip on Hover -->
                <span class="absolute left-0 top-0 bottom-0 w-[3px] bg-accent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Single Category Banner (when no subproducts) -->
  {
    !hasGrid && (
      <section class="bg-paper pb-0" data-reveal>
        <div class="site-wrap">
          <div class="relative aspect-[16/9] overflow-hidden rounded-xl border border-line bg-surface lg:aspect-[21/9] shadow-sm">
            <PhotoFrame
              src={category.image}
              class="absolute inset-0 h-full w-full object-contain p-6"
              width={1400}
              height={700}
              loading="eager"
              fetchpriority="high"
            />
            <span class="cad-cross cad-tl" aria-hidden="true">+</span>
            <span class="cad-cross cad-tr" aria-hidden="true">+</span>
            <span class="cad-cross cad-bl" aria-hidden="true">+</span>
            <span class="cad-cross cad-br" aria-hidden="true">+</span>
          </div>
        </div>
      </section>
    )
  }

  <!-- Details & Specifications -->
  {
    hasDetails && (
      <section class="section-y bg-paper" data-reveal>
        <div class="site-wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
          {category.body && category.body.length > 0 && (
            <div class={category.specs?.length ? "lg:col-span-7" : "lg:col-span-8"}>
              <SectionMeta kicker={t("page.aboutProduct")} index={detailsN} total={TOTAL} />
              <div class="space-y-4 text-base leading-relaxed text-muted-on-ink mt-6">
                {category.body.map((p) => <p>{p}</p>)}
              </div>
            </div>
          )}
          {category.aiBody && category.aiBody.length > 0 && (
            <div class={category.body?.length ? "lg:col-span-8" : category.specs?.length ? "lg:col-span-7" : "lg:col-span-8"}>
              {(!category.body || category.body.length === 0) && (
                <SectionMeta kicker={t("page.aboutProduct")} index={detailsN} total={TOTAL} />
              )}
              <div class="space-y-4 text-base leading-relaxed text-muted-on-ink mt-6">
                {category.aiBody.map((p) => <p>{p}</p>)}
              </div>
            </div>
          )}
          {category.specs && category.specs.length > 0 && (
            <div class={category.body?.length ? "lg:col-span-5" : "lg:col-span-8"}>
              {(!category.body || category.body.length === 0) && (
                <SectionMeta kicker={t("page.specs")} index={detailsN} total={TOTAL} />
              )}
              {category.body && category.body.length > 0 && <p class="t-overline mb-4">{t("page.specs")}</p>}
              <div class="overflow-hidden rounded-xl border border-line bg-surface p-6 shadow-xs">
                <div class="spec-list">
                  {category.specs.map((row) => (
                    <div class="spec-row py-2 border-b border-line/50 last:border-0 flex justify-between gap-4 text-sm">
                      <p class="spec-key text-muted">{row.key}</p>
                      <p class="font-medium text-ink text-right">{row.value}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}
          {category.features && category.features.length > 0 && (
            <div class="lg:col-span-12 mt-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {category.features.map((item, i) => (
                  <div class="feature-item p-4 rounded-lg border border-line bg-surface/60">
                    <span class="t-overline text-cyan">{pad(i + 1)}</span>
                    <p class="mt-1 text-sm text-ink">{item}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- Related Categories Links -->
  <RelatedLinks lang={lang} kicker={t("page.related")} index={relatedN} total={TOTAL} items={related} />

  <!-- CTA Quote Band / Section -->
  {
    category.embedQuote ? (
      <QuoteSection lang={lang} index={ctaN} total={TOTAL} catalogCta={category.ctaCatalog} />
    ) : (
      <QuoteBand lang={lang} index={ctaN} total={TOTAL} />
    )
  }

  <!-- SEO and FAQ Section -->
  {
    category.seo && (
      <section class="section-y bg-paper" data-reveal>
        <div class="site-wrap">
          <SectionMeta kicker={t("page.seo")} index={seoN} total={TOTAL} />
          <h2 class="t-display mt-4">{category.seo.heading}</h2>
          <div class="seo-block mt-8 space-y-4 text-base leading-relaxed text-muted-on-ink">
            {category.seo.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          {category.seo.faqs && category.seo.faqs.length > 0 && (
            <div class="mt-12 max-w-3xl space-y-3">
              {category.seo.faqs.map((item) => (
                <details class="faq-item group rounded-lg border border-line bg-surface p-4 transition-colors hover:border-accent/50">
                  <summary class="cursor-pointer font-semibold text-ink flex items-center justify-between">
                    <span>{item.q}</span>
                    <span class="ml-2 text-muted group-open:rotate-180 transition-transform duration-200">↓</span>
                  </summary>
                  <p class="mt-3 text-sm leading-relaxed text-muted-on-ink border-t border-line/40 pt-3">{item.a}</p>
                </details>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }
</article>
