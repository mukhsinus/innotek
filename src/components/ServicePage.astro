---
import QuoteBand from "./QuoteBand.astro";
import SectionMeta from "./SectionMeta.astro";
import { SERVICES, type ServicePage } from "../data/services";
import type { Lang } from "../i18n/ui";
import { hrefFor, useT } from "../i18n/utils";

interface Props {
  lang: Lang;
  service: ServicePage;
}

const { lang, service } = Astro.props;
const t = useT(lang);
const TOTAL = 3;
const related = SERVICES.filter((s) => s.path !== service.path);
---

<article>
  <header class="page-head bg-paper" data-reveal>
    <div class="site-wrap">
      <SectionMeta kicker={t("page.kickerService")} index={1} total={TOTAL} />
      <h1 class="t-display">{service.h1}</h1>
      <p class="t-lead">{service.lead}</p>
    </div>
  </header>

  {
    service.image && (
      <section class="bg-paper pb-0" data-reveal>
        <div class="site-wrap">
          <div class="relative aspect-[16/9] overflow-hidden bg-ink lg:aspect-[16/7]">
            <img
              src={service.image}
              alt=""
              class="photo-grade absolute inset-0 h-full w-full object-cover"
              width="1400"
              height="700"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </section>
    )
  }

  <section class="section-y bg-paper" data-reveal>
    <div class="site-wrap grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionMeta kicker={t("page.how")} index={2} total={TOTAL} />
        <p class="max-w-xl text-lg leading-relaxed text-muted">{service.body}</p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <p class="t-overline mb-6">{t("page.moreServices")}</p>
        <ul class="spec-list">
          {
            related.map((item, i) => (
              <li class="spec-row">
                <p class="spec-key">{String(i + 1).padStart(2, "0")}</p>
                <a class="text-link" href={hrefFor(lang, item.path)}>
                  {t(item.labelKey)}
                  <span class="link-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <QuoteBand lang={lang} index={3} total={TOTAL} />
</article>
