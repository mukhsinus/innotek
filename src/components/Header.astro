---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";
import { catalogNav, primaryNav, servicesNav, type NavLink } from "../data/navigation";
import { SITE } from "../data/site";
import type { Lang } from "../i18n/ui";
import { hrefFor, useT } from "../i18n/utils";
import { HOME } from "../data/home";

interface Props {
  lang: Lang;
  overlay?: boolean;
}

const { lang, overlay = false } = Astro.props;
const t = useT(lang);
const here = Astro.url.pathname;
const copy = HOME[lang];

function isActive(path: string) {
  const href = hrefFor(lang, path);
  if (href === "/" || href === "/uz/") return here === href;
  return here === href || here.startsWith(href);
}

function link(item: NavLink) {
  return hrefFor(lang, item.path);
}

const homeHref = hrefFor(lang, "/");
const quoteHref = `${hrefFor(lang, "/contacts/")}#quote`;

/* Category images for mega menu thumbnails */
const catImages: Record<string, string> = {};
copy.categories.forEach((cat) => {
  catImages[cat.path] = cat.image?.startsWith("/src/assets/images/")
    ? cat.image.replace("/src/assets/images/", "/images/")
    : cat.image;
});
---

<header
  id="site-header"
  class="fixed top-0 right-0 left-0 z-50"
  data-overlay={overlay ? "" : undefined}
>
  <div class="header-inner site-wrap flex items-center justify-between gap-4 py-4 lg:py-5">
    <a href={homeHref} class="flex shrink-0 items-center gap-2.5" aria-label={SITE.name}>
      <Logo class="h-7 w-7" />
      <span class="text-[0.8125rem] font-semibold tracking-[0.18em]" style="font-family: var(--font-display)">INNOTEK</span>
    </a>

    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex items-center text-[0.8125rem] font-medium">
        {
          primaryNav.map((item) => (
            <li class:list={[item.path === "/services/" && "relative"]}>
              <a
                href={link(item)}
                class:list={[
                  "inline-flex items-center gap-1 px-3 py-2 opacity-60 transition-opacity hover:opacity-100",
                  isActive(item.path) && "opacity-100 text-accent",
                ]}
                aria-current={isActive(item.path) ? "page" : undefined}
                aria-haspopup={item.children ? "true" : undefined}
                aria-controls={item.path === "/catalog/" ? "nav-flyout-catalog" : item.path === "/services/" ? "nav-flyout-services" : undefined}
                aria-expanded={item.children ? "false" : undefined}
                data-flyout-trigger={item.path === "/catalog/" ? "catalog" : item.path === "/services/" ? "services" : undefined}
              >
                {t(item.labelKey)}
                {item.children && (
                  <svg class="h-3 w-3 opacity-70" viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4"></path>
                  </svg>
                )}
              </a>

              {item.path === "/services/" && (
                <div id="nav-flyout-services" class="nav-flyout nav-flyout-sub" data-flyout-panel="services">
                  <ul class="border-t border-line bg-surface py-3 text-ink">
                    {servicesNav.map((child) => (
                      <li>
                        <a class="block px-4 py-2 text-sm text-muted-on-ink hover:text-accent" href={link(child)}>
                          {t(child.labelKey)}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        class="hidden text-[0.8125rem] font-medium tracking-wide opacity-60 hover:opacity-100 transition-opacity min-[1281px]:inline-flex"
        href={`tel:${SITE.phone.tel}`}
      >
        {SITE.phone.display}
      </a>
      <LanguageSwitcher lang={lang} />
      <a class="btn-header-quote hidden md:inline-flex" href={quoteHref}>{t("cta.quote")}</a>
      <button
        id="menu-btn"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t("menu.open")}
      >
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mega menu: catalog with thumbnails -->
  <div id="nav-flyout-catalog" class="nav-flyout nav-flyout-full" data-flyout-panel="catalog">
    <div class="border-t border-line bg-surface text-ink">
      <div class="site-wrap py-10">
        <div class="site-grid" style="background: transparent; gap: 0">
          {
            catalogNav.map((cat) => (
              <div class="col-span-4 lg:col-span-3 p-4" style="background: transparent">
                <a href={link(cat)} class="group block">
                  {catImages[cat.path] && (
                    <div class="relative aspect-[4/3] overflow-hidden bg-paper mb-3">
                      <img
                        src={catImages[cat.path]}
                        alt=""
                        class="h-full w-full object-cover photo-grade"
                        width="400"
                        height="300"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}
                  <span class="text-sm font-medium text-ink group-hover:text-accent transition-colors">
                    {t(cat.labelKey)}
                  </span>
                </a>
                {cat.children && (
                  <ul class="mt-3 space-y-1.5 text-sm text-muted">
                    {cat.children.map((child) => (
                      <li>
                        <a class="hover:text-ink transition-colors" href={link(child)}>
                          {t(child.labelKey)}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-nav" class="hidden border-t border-line bg-surface text-ink lg:hidden" hidden>
    <nav class="site-wrap max-h-[min(80vh,40rem)] overflow-y-auto py-4" aria-label="Mobile">
      <a class="btn-accent mb-6 w-full" href={quoteHref}>{t("cta.quote")}</a>
      {
        primaryNav.map((item) =>
          item.children ? (
            <details class="border-b border-line py-2">
              <summary class="cursor-pointer py-2 text-sm font-semibold">
                {t(item.labelKey)}
              </summary>
              <ul class="space-y-3 pb-3 pl-1 text-sm text-muted">
                <li>
                  <a class="font-semibold text-ink" href={link(item)}>
                    {t(item.labelKey)}
                  </a>
                </li>
                {item.path === "/catalog/"
                  ? catalogNav.map((cat) => (
                      <li>
                        <a class="font-semibold text-ink" href={link(cat)}>
                          {t(cat.labelKey)}
                        </a>
                        {cat.children && (
                          <ul class="mt-1.5 space-y-1 pl-3">
                            {cat.children.map((child) => (
                              <li>
                                <a href={link(child)}>{t(child.labelKey)}</a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))
                  : item.children.map((child) => (
                      <li>
                        <a href={link(child)}>{t(child.labelKey)}</a>
                      </li>
                    ))}
              </ul>
            </details>
          ) : (
            <a class="block border-b border-line py-3 text-sm font-semibold" href={link(item)}>
              {t(item.labelKey)}
            </a>
          ),
        )
      }
    </nav>
  </div>
  <div class="read-progress" aria-hidden="true">
    <span id="read-progress-bar" class="read-progress-bar"></span>
  </div>
</header>
