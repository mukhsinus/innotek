---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";
import {
  catalogNav,
  primaryNav,
  servicesNav,
  type NavLink,
} from "../data/navigation";
import { SITE } from "../data/site";
import type { Lang } from "../i18n/ui";
import { hrefFor, useT } from "../i18n/utils";
import { HOME } from "../data/home";
import { SERVICES } from "../data/services";
import { photoSrcWebp, photoSrcFallback } from "../lib/image";

interface Props {
  lang: Lang;
  overlay?: boolean;
}

const { lang, overlay = false } = Astro.props;
const t = useT(lang);
const isUz = lang === "uz";
const here = Astro.url.pathname;
const copy = HOME[lang];

function isActive(path: string) {
  const href = hrefFor(lang, path);
  if (href === "/" || href === "/uz/") return here === href;
  return here === href || here.startsWith(href);
}

function link(item: NavLink) {
  return hrefFor(lang, item.path);
}

const homeHref = hrefFor(lang, "/");
const quoteHref = `${hrefFor(lang, "/contacts/")}#quote`;

interface MenuPhotoData {
  webp?: string;
  fallback: string;
}

/* Thumbnails stay unloaded until the flyout opens. 640px covers a retina card. */
const catImages: Record<string, MenuPhotoData> = {};
copy.categories.forEach((cat) => {
  const webp = photoSrcWebp(cat.image, 640);
  const fallback = photoSrcFallback(cat.image, 640) || webp;
  if (fallback) catImages[cat.path] = { webp, fallback };
});

const serviceImages: Record<string, MenuPhotoData> = {};
SERVICES.forEach((srv) => {
  const webp = photoSrcWebp(srv.image, 640);
  const fallback = photoSrcFallback(srv.image, 640) || webp;
  if (fallback) serviceImages[srv.path] = { webp, fallback };
});
---

<header
  id="site-header"
  class="fixed top-0 right-0 left-0 z-50 h-16 border-b border-line"
>
  <div
    class="header-inner site-wrap flex h-full items-center justify-between gap-4"
  >
    <a
      href={homeHref}
      class="flex shrink-0 items-center gap-2.5 sm:gap-3"
      aria-label={SITE.name}
    >
      <Logo class="h-8.5 w-8.5 lg:h-7 lg:w-7" />
      <span
        class="text-sm lg:text-[0.8125rem] font-semibold tracking-[0.18em]"
        style="font-family: var(--font-display)">INNOTEK</span
      >
    </a>

    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex items-center text-[0.9375rem] font-medium">
        {
          primaryNav.map((item) => (
            <li class:list={[item.path === "/services/" && "relative"]}>
              <a
                href={link(item)}
                class:list={[
                  "inline-flex items-center gap-1 px-3 py-2 text-ink-soft transition-colors hover:text-accent",
                  isActive(item.path) && "text-accent",
                ]}
                aria-current={isActive(item.path) ? "page" : undefined}
                aria-haspopup={item.children ? "true" : undefined}
                aria-controls={
                  item.path === "/catalog/"
                    ? "nav-flyout-catalog"
                    : item.path === "/services/"
                      ? "nav-flyout-services"
                      : undefined
                }
                aria-expanded={item.children ? "false" : undefined}
                data-flyout-trigger={
                  item.path === "/catalog/"
                    ? "catalog"
                    : item.path === "/services/"
                      ? "services"
                      : undefined
                }
              >
                {t(item.labelKey)}
                {item.children && (
                  <svg
                    class="h-3 w-3 opacity-70"
                    viewBox="0 0 12 12"
                    aria-hidden="true"
                  >
                    <path
                      d="M2.5 4.5 6 8l3.5-3.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                    />
                  </svg>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        class="hidden text-[0.9375rem] font-medium tracking-wide text-ink-soft transition-colors hover:text-accent min-[1281px]:inline-flex"
        href={`tel:${SITE.phone.tel}`}
      >
        {SITE.phone.display}
      </a>
      <LanguageSwitcher lang={lang} />
      <a class="btn-header-quote hidden md:inline-flex" href={quoteHref}
        >{t("cta.quote")}</a
      >
      <button
        id="menu-btn"
        type="button"
        class="relative inline-flex h-10 w-10 items-center justify-center rounded-lg border border-line bg-paper text-ink transition-colors hover:border-accent lg:hidden cursor-pointer shadow-xs"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t("menu.open")}
      >
        <span class="sr-only">{t("menu.open")}</span>
        <div class="relative flex h-3.5 w-4 flex-col justify-between" aria-hidden="true">
          <span class="bar-1 block h-[2px] w-full rounded bg-current transition-all duration-300"></span>
          <span class="bar-2 block h-[2px] w-full rounded bg-current transition-all duration-300"></span>
          <span class="bar-3 block h-[2px] w-full rounded bg-current transition-all duration-300"></span>
        </div>
      </button>
    </div>
  </div>

  <!-- Mega menu: catalog with thumbnails in original ratios, 7x2 grid, zero-scroll layout -->
  <div
    id="nav-flyout-catalog"
    class="nav-flyout nav-flyout-full shadow-2xl"
    data-flyout-panel="catalog"
  >
    <div class="menu-panel">
      <div class="site-wrap py-4 xl:py-5">
        <div class="grid grid-cols-7 gap-3">
          {
            catalogNav.map((cat, idx) => {
              const hasChildren = Boolean(
                cat.children && cat.children.length > 0,
              );
              const colPos = idx % 7;
              const opensUp = idx >= 7;

              return (
                <div class="menu-card group" style={`--i: ${idx}`}>
                  <a
                    href={link(cat)}
                    class="menu-tile"
                    title={t(cat.labelKey)}
                  >
                    <div class="menu-photo">
                      {catImages[cat.path] ? (
                        <picture style="display: contents;">
                          {catImages[cat.path].webp && catImages[cat.path].webp !== catImages[cat.path].fallback && (
                            <source data-srcset={catImages[cat.path].webp} type="image/webp" />
                          )}
                          <img
                            data-src={catImages[cat.path].fallback}
                            alt=""
                            class="menu-photo-img"
                            width="320"
                            height="220"
                            decoding="async"
                          />
                        </picture>
                      ) : (
                        <div class="menu-photo-fallback">INNOTEK</div>
                      )}
                    </div>

                    <div class="menu-copy">
                      <span class="menu-title">{t(cat.labelKey)}</span>
                      {hasChildren && (
                        <span class="menu-count">
                          <span>{cat.children!.length} {isUz ? "tur" : "видов"}</span>
                          <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <path
                              d="M2.5 4.5 6 8l3.5-3.5"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </span>
                      )}
                    </div>
                  </a>

                  {hasChildren && (
                    <div
                      class:list={[
                        "menu-popover",
                        colPos === 0 ? "is-start" : colPos === 6 ? "is-end" : "is-mid",
                        opensUp && "is-up",
                      ]}
                    >
                      <div class="menu-popover-panel">
                        <a href={link(cat)} class="menu-popover-all">
                          <span>{isUz ? "Barcha toifalar" : "Все товары категории"}</span>
                          <span aria-hidden="true">→</span>
                        </a>
                        <div class="menu-popover-list">
                          {cat.children!.map((child) => (
                            <a href={link(child)} class="menu-popover-link">
                              {t(child.labelKey)}
                            </a>
                          ))}
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Mega menu: services with thumbnails -->
  <div
    id="nav-flyout-services"
    class="nav-flyout nav-flyout-full shadow-2xl"
    data-flyout-panel="services"
  >
    <div class="menu-panel menu-panel-scroll">
      <div class="site-wrap py-4 xl:py-5">
        <div class="grid grid-cols-6 gap-3.5 xl:gap-4">
          {
            servicesNav.map((srv, idx) => (
              <div class="menu-card" style={`--i: ${idx}`}>
                <a href={link(srv)} class="menu-tile" title={t(srv.labelKey)}>
                  {serviceImages[srv.path] && (
                    <div class="menu-photo">
                      <picture style="display: contents;">
                        {serviceImages[srv.path].webp && serviceImages[srv.path].webp !== serviceImages[srv.path].fallback && (
                          <source data-srcset={serviceImages[srv.path].webp} type="image/webp" />
                        )}
                        <img
                          data-src={serviceImages[srv.path].fallback}
                          alt=""
                          class="menu-photo-img"
                          width="320"
                          height="220"
                          decoding="async"
                        />
                      </picture>
                    </div>
                  )}
                  <div class="menu-copy">
                    <span class="menu-title">{t(srv.labelKey)}</span>
                  </div>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile nav with Smooth Animated Appearance & Accordions -->
  <div
    id="mobile-nav"
    class="mobile-nav-panel border-t border-line bg-surface/98 backdrop-blur-xl text-ink lg:hidden shadow-2xl"
    aria-hidden="true"
  >
    <nav
      class="site-wrap max-h-[calc(100vh-4.5rem)] overflow-y-auto py-5 space-y-2"
      aria-label="Mobile"
    >
      <a class="btn-accent mb-4 w-full justify-center shadow-md text-center" href={quoteHref}>
        <span>{t("cta.quote")}</span>
        <span class="link-arrow" aria-hidden="true">→</span>
      </a>

      {
        primaryNav.map((item, idx) => {
          const hasChildren = Boolean(item.children && item.children.length > 0);
          const topAccordionId = `mob-acc-${idx}`;

          if (!hasChildren) {
            return (
              <a
                class:list={[
                  "flex items-center justify-between rounded-xl px-4 py-3 text-sm font-semibold transition-all duration-200",
                  isActive(item.path)
                    ? "bg-paper text-accent shadow-xs border border-line"
                    : "text-ink hover:bg-paper hover:text-accent border border-transparent",
                ]}
                href={link(item)}
              >
                <span>{t(item.labelKey)}</span>
                <span class="text-xs text-muted-on-ink">→</span>
              </a>
            );
          }

          return (
            <div class="rounded-xl border border-line/60 bg-paper/50 overflow-hidden shadow-xs">
              <button
                type="button"
                class="mobile-acc-trigger flex w-full items-center justify-between px-4 py-3.5 text-left text-sm font-semibold text-ink hover:text-accent transition-colors cursor-pointer"
                aria-expanded="false"
                aria-controls={topAccordionId}
                data-mob-accordion-btn
              >
                <span class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
                  <span>{t(item.labelKey)}</span>
                </span>
                <svg
                  class="mob-chevron h-4 w-4 text-muted-on-ink transition-transform duration-300 shrink-0"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M4 6l4 4 4-4"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>

              <div id={topAccordionId} class="mobile-acc-content">
                <div class="px-3.5 pb-3 pt-1 border-t border-line/40 space-y-2">
                  <!-- Direct link to category/service hub page -->
                  <a
                    class="flex items-center justify-between rounded-lg bg-surface px-3 py-3 text-base font-semibold text-accent shadow-xs border border-line hover:bg-paper transition-colors"
                    href={link(item)}
                  >
                    <span>
                      {item.path === "/catalog/"
                        ? isUz
                          ? "Barcha mahsulotlar katalogi →"
                          : "Все категории каталога →"
                        : isUz
                          ? "Barcha xizmatlar ro'yxati →"
                          : "Все услуги компании →"}
                    </span>
                  </a>

                  {item.path === "/catalog/" ? (
                    <div class="space-y-1.5 pt-1">
                      {catalogNav.map((cat, catIdx) => {
                        const hasSubChildren = Boolean(cat.children && cat.children.length > 0);
                        const subAccordionId = `mob-sub-${idx}-${catIdx}`;

                        if (!hasSubChildren) {
                          return (
                            <a
                              class="flex items-center justify-between rounded-lg px-3 py-3 text-base font-medium text-ink hover:bg-paper hover:text-accent transition-colors"
                              href={link(cat)}
                            >
                              <span>{t(cat.labelKey)}</span>
                              <span class="text-sm text-muted-on-ink">→</span>
                            </a>
                          );
                        }

                        return (
                          <div class="rounded-lg bg-surface/80 border border-line/50 overflow-hidden">
                            <button
                              type="button"
                              class="mobile-sub-trigger flex w-full items-center justify-between px-3 py-3 text-left text-base font-semibold text-ink hover:text-accent transition-colors cursor-pointer"
                              aria-expanded="false"
                              aria-controls={subAccordionId}
                              data-mob-accordion-btn
                            >
                              <span>{t(cat.labelKey)}</span>
                              <svg
                                class="mob-chevron h-3.5 w-3.5 text-muted-on-ink transition-transform duration-300 shrink-0"
                                viewBox="0 0 16 16"
                                fill="none"
                                aria-hidden="true"
                              >
                                <path
                                  d="M4 6l4 4 4-4"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                              </svg>
                            </button>

                            <div id={subAccordionId} class="mobile-acc-content">
                              <div class="pl-4 pr-3 py-2 space-y-1.5 border-t border-line/30 bg-paper/40">
                                <a
                                  class="block py-2 text-base font-semibold text-accent hover:underline"
                                  href={link(cat)}
                                >
                                  {isUz ? "Bo'limga o'tish →" : "Все товары категории →"}
                                </a>
                                {cat.children!.map((child) => (
                                  <a
                                    class="block py-2 text-base leading-snug text-ink hover:text-accent transition-colors"
                                    href={link(child)}
                                  >
                                    {t(child.labelKey)}
                                  </a>
                                ))}
                              </div>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  ) : (
                    <div class="space-y-1 pt-1">
                      {servicesNav.map((child) => (
                        <a
                          class="flex items-center justify-between rounded-lg px-3 py-3 text-base font-medium text-ink hover:bg-paper hover:text-accent transition-colors"
                          href={link(child)}
                        >
                          <span>{t(child.labelKey)}</span>
                          <span class="text-sm text-muted-on-ink">→</span>
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })
      }

      <!-- Bottom Quick Contact Strip in Mobile Menu -->
      <div class="pt-4 mt-4 border-t border-line flex flex-col gap-2.5 text-xs font-mono text-muted-on-ink">
        <a
          class="flex items-center justify-between rounded-xl border border-line bg-paper p-3 text-ink font-semibold hover:border-accent hover:text-accent transition-colors shadow-2xs"
          href={`tel:${SITE.phone.tel}`}
        >
          <span>{SITE.phone.display}</span>
          <span class="text-accent font-sans text-xs">ПОЗВОНИТЬ</span>
        </a>
        <a
          class="flex items-center justify-between rounded-xl border border-line bg-paper p-3 text-ink hover:border-cyan hover:text-cyan transition-colors shadow-2xs"
          href={SITE.socials.telegram}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>TELEGRAM // @Innotek_invest</span>
          <span class="text-cyan font-bold">↗</span>
        </a>
      </div>
    </nav>
  </div>
  <div class="read-progress" aria-hidden="true">
    <span id="read-progress-bar" class="read-progress-bar"></span>
  </div>
</header>
