---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";
import { catalogNav, primaryNav, servicesNav, type NavLink } from "../data/navigation";
import { SITE } from "../data/site";
import type { Lang } from "../i18n/ui";
import { hrefFor, useT } from "../i18n/utils";

interface Props {
  lang: Lang;
  overlay?: boolean;
}

const { lang, overlay = false } = Astro.props;
const t = useT(lang);
const here = Astro.url.pathname;

function isActive(path: string) {
  const href = hrefFor(lang, path);
  if (href === "/" || href === "/uz/") return here === href;
  return here === href || here.startsWith(href);
}

function link(item: NavLink) {
  return hrefFor(lang, item.path);
}

const homeHref = hrefFor(lang, "/");
const quoteHref = `${hrefFor(lang, "/contacts/")}#quote`;
---

<header
  id="site-header"
  class="fixed top-0 right-0 left-0 z-50"
  data-overlay={overlay ? "" : undefined}
>
  <div class="header-inner site-wrap flex items-center justify-between gap-4 py-4 lg:py-5">
    <a href={homeHref} class="flex shrink-0 items-center gap-2.5" aria-label={SITE.name}>
      <Logo class="h-7 w-7" />
      <span class="text-[0.8125rem] font-semibold tracking-[0.18em]">INNOTEK</span>
    </a>

    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex items-center text-[0.8125rem] font-medium">
        {
          primaryNav.map((item) => (
            <li class:list={["group/item", item.path === "/catalog/" ? "static" : "relative"]}>
              <a
                href={link(item)}
                class:list={[
                  "inline-flex items-center gap-1 px-3 py-2 opacity-70 transition-opacity hover:opacity-100",
                  isActive(item.path) && "opacity-100",
                ]}
                aria-current={isActive(item.path) ? "page" : undefined}
                aria-haspopup={item.children ? "true" : undefined}
              >
                {t(item.labelKey)}
                {item.children && (
                  <svg class="h-3 w-3 opacity-70" viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4"></path>
                  </svg>
                )}
              </a>

              {item.path === "/catalog/" && item.children && (
                <div class="invisible absolute top-full right-0 left-0 z-50 pt-2 opacity-0 transition group-hover/item:visible group-hover/item:opacity-100 group-focus-within/item:visible group-focus-within/item:opacity-100">
                  <div class="border-t border-line bg-paper text-ink">
                    <div class="site-wrap py-10">
                      <div class="site-grid">
                        {
                          catalogNav.map((cat) => (
                            <div class="col-span-4 lg:col-span-3">
                              <a href={link(cat)} class="text-sm font-medium hover:text-accent-ink">
                                {t(cat.labelKey)}
                              </a>
                              {cat.children && (
                                <ul class="mt-3 space-y-1.5 text-sm text-muted">
                                  {cat.children.map((child) => (
                                    <li>
                                      <a class="hover:text-ink" href={link(child)}>
                                        {t(child.labelKey)}
                                      </a>
                                    </li>
                                  ))}
                                </ul>
                              )}
                            </div>
                          ))
                        }
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {item.path === "/services/" && (
                <div class="invisible absolute top-full left-0 z-50 min-w-52 pt-2 opacity-0 transition group-hover/item:visible group-hover/item:opacity-100 group-focus-within/item:visible group-focus-within/item:opacity-100">
                  <ul class="border-t border-line bg-paper py-3 text-ink">
                    {servicesNav.map((child) => (
                      <li>
                        <a class="block px-4 py-2 text-sm hover:text-accent-ink" href={link(child)}>
                          {t(child.labelKey)}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        class="hidden text-[0.8125rem] font-medium tracking-wide min-[1281px]:inline-flex"
        href={`tel:${SITE.phone.tel}`}
      >
        {SITE.phone.display}
      </a>
      <LanguageSwitcher lang={lang} />
      <a class="btn-header-quote hidden md:inline-flex" href={quoteHref}>{t("cta.quote")}</a>
      <button
        id="menu-btn"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t("menu.open")}
      >
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-line bg-paper text-ink lg:hidden" hidden>
    <nav class="site-wrap max-h-[min(80vh,40rem)] overflow-y-auto py-4" aria-label="Mobile">
      <a class="btn-primary mb-6 w-full" href={quoteHref}>{t("cta.quote")}</a>
      {
        primaryNav.map((item) =>
          item.children ? (
            <details class="border-b border-line py-2">
              <summary class="cursor-pointer py-2 text-sm font-semibold">
                {t(item.labelKey)}
              </summary>
              <ul class="space-y-3 pb-3 pl-1 text-sm text-muted">
                <li>
                  <a class="font-semibold text-ink" href={link(item)}>
                    {t(item.labelKey)}
                  </a>
                </li>
                {item.path === "/catalog/"
                  ? catalogNav.map((cat) => (
                      <li>
                        <a class="font-semibold text-ink" href={link(cat)}>
                          {t(cat.labelKey)}
                        </a>
                        {cat.children && (
                          <ul class="mt-1.5 space-y-1 pl-3">
                            {cat.children.map((child) => (
                              <li>
                                <a href={link(child)}>{t(child.labelKey)}</a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))
                  : item.children.map((child) => (
                      <li>
                        <a href={link(child)}>{t(child.labelKey)}</a>
                      </li>
                    ))}
              </ul>
            </details>
          ) : (
            <a class="block border-b border-line py-3 text-sm font-semibold" href={link(item)}>
              {t(item.labelKey)}
            </a>
          ),
        )
      }
    </nav>
  </div>
  <div class="read-progress" aria-hidden="true">
    <span id="read-progress-bar" class="read-progress-bar"></span>
  </div>
</header>
