---
import { photoSrcWebp, photoSrcFallback } from "../lib/image";

interface Props {
  src?: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
}

const {
  src,
  class: className,
  width = 800,
  height = 600,
  loading = "lazy",
  fetchpriority,
} = Astro.props;

const targetWidth = Math.min(1600, Math.round(width * 2));
const webpSrc = photoSrcWebp(src, targetWidth);
const fallbackSrc = photoSrcFallback(src, targetWidth) || webpSrc;
---

{
  fallbackSrc ? (
    <picture class="photo-frame-picture">
      {webpSrc && webpSrc !== fallbackSrc && (
        <source srcset={webpSrc} type="image/webp" />
      )}
      <img
        src={fallbackSrc}
        alt=""
        class:list={["photo-grade", className]}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
      />
    </picture>
  ) : (
    <div class:list={["photo-placeholder", className]} aria-hidden="true">
      <span>INNOTEK</span>
    </div>
  )
}

<style>
  .photo-frame-picture {
    display: contents;
  }
</style>
