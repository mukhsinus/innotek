---
import Logo from "./Logo.astro";
import { catalogNav, primaryNav } from "../data/navigation";
import { SITE } from "../data/site";
import type { Lang } from "../i18n/ui";
import { hrefFor, useT } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
const homeHref = hrefFor(lang, "/");
const companyLinks = primaryNav.filter((i) => i.path !== "/catalog/");
---

<footer class="border-t border-line bg-paper text-ink">
  <div class="site-wrap grid grid-cols-4 gap-x-8 gap-y-12 py-14 text-[0.8125rem] leading-6 lg:grid-cols-12 lg:py-16">
    <div class="col-span-4 lg:col-span-3">
      <a href={homeHref} class="inline-flex items-center gap-2.5" aria-label={SITE.name}>
        <Logo class="h-7 w-7" />
        <span class="text-xs font-semibold tracking-[0.16em]">INNOTEK</span>
      </a>
    </div>

    <div class="col-span-4 md:col-span-2 lg:col-span-3">
      <p class="text-[0.7rem] tracking-[0.12em] text-muted uppercase">{t("footer.products")}</p>
      <ul class="mt-4 space-y-2 text-muted">
        {
          catalogNav.map((item) => (
            <li>
              <a class="hover:text-ink" href={hrefFor(lang, item.path)}>
                {t(item.labelKey)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="col-span-4 md:col-span-2 lg:col-span-3">
      <p class="text-[0.7rem] tracking-[0.12em] text-muted uppercase">{t("footer.company")}</p>
      <ul class="mt-4 space-y-2 text-muted">
        {
          companyLinks.map((item) => (
            <li>
              <a class="hover:text-ink" href={hrefFor(lang, item.path)}>
                {t(item.labelKey)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="col-span-4 lg:col-span-3">
      <p class="text-[0.7rem] tracking-[0.12em] text-muted uppercase">{t("footer.contacts")}</p>
      <ul class="mt-4 space-y-2">
        <li>
          <a class="hover:text-accent-ink" href={`tel:${SITE.phone.tel}`}>{SITE.phone.display}</a>
        </li>
        <li>
          <a class="hover:text-accent-ink" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="site-wrap py-4 text-[0.7rem] text-muted">© {year} {SITE.legalName}</p>
  </div>
</footer>
