---
import { SITE } from "../data/site";
import type { Lang } from "../i18n/ui";
import { useT } from "../i18n/utils";

interface Props {
  lang: Lang;
  variant?: "hero" | "compact" | "card";
  class?: string;
}

const { lang, variant = "hero", class: className = "" } = Astro.props;
const t = useT(lang);
const isUz = lang === "uz";
const size = isUz ? SITE.catalogPdf.sizeUz : SITE.catalogPdf.size;
const pdfUrl = SITE.catalogPdf.url;
const filename = SITE.catalogPdf.filename;
---

{
  variant === "hero" ? (
    <div
      class:list={[
        "catalog-download-hero relative overflow-hidden rounded-xl border border-line bg-paper p-6 sm:p-8 lg:p-9 shadow-sm transition-all duration-300 hover:border-accent/40",
        className,
      ]}
    >
      <!-- CAD crosshairs -->
      <span class="cad-cross cad-tl text-accent" aria-hidden="true">+</span>
      <span class="cad-cross cad-tr text-accent" aria-hidden="true">+</span>
      <span class="cad-cross cad-bl text-accent" aria-hidden="true">+</span>
      <span class="cad-cross cad-br text-accent" aria-hidden="true">+</span>

      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 lg:gap-10">
        <!-- Left: Copy & Specifications -->
        <div class="max-w-2xl space-y-3">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-1.5 rounded-md bg-accent/10 px-2.5 py-1 text-[11px] font-mono font-bold uppercase tracking-wider text-accent border border-accent/20">
              <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
              </svg>
              <span>PDF CATALOG</span>
            </span>
            <span class="text-xs font-mono text-cyan tracking-wider font-semibold">
              00 // {t("catalog.downloadBadge")}
            </span>
            <span class="text-xs font-mono text-muted-on-ink">· {size}</span>
          </div>

          <h2 class="text-xl sm:text-2xl font-bold font-display text-ink tracking-tight">
            {isUz ? "Innotek rasmiy mahsulotlar katalogi 2025" : "Официальный каталог продукции Innotek 2025"}
          </h2>

          <p class="text-sm text-muted-on-ink leading-relaxed">
            {t("catalog.downloadLead")}
          </p>
        </div>

        <!-- Right: Action Buttons -->
        <div class="flex flex-col sm:flex-row lg:flex-col xl:flex-row items-stretch sm:items-center gap-3 shrink-0">
          <a
            href={pdfUrl}
            download={filename}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-accent inline-flex items-center justify-center gap-3 px-6 py-3.5 text-sm font-semibold shadow-md hover:shadow-accent/25 transition-all text-center rounded-lg group"
            id="btn-download-catalog-main"
          >
            <svg
              class="h-5 w-5 shrink-0 transition-transform duration-200 group-hover:translate-y-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>{t("catalog.download")}</span>
            <span class="rounded bg-black/20 px-2 py-0.5 text-[11px] font-mono tracking-wider font-normal">
              {size}
            </span>
          </a>

          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 px-4 py-3 text-xs font-mono font-medium text-ink-soft hover:text-accent transition-colors text-center"
            title={t("catalog.openInBrowser")}
          >
            <span>{t("catalog.openInBrowser")}</span>
            <span class="link-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  ) : (
    <a
      href={pdfUrl}
      download={filename}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        "inline-flex items-center gap-2 rounded-lg border border-accent/30 bg-accent/10 px-4 py-2.5 text-xs font-semibold text-ink transition-all hover:bg-accent hover:text-paper hover:shadow-sm group",
        className,
      ]}
    >
      <svg
        class="h-4 w-4 shrink-0 text-accent group-hover:text-paper transition-colors"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <span>{t("catalog.download")}</span>
      <span class="rounded bg-black/10 group-hover:bg-black/20 px-1.5 py-0.5 font-mono text-[10px]">
        {size}
      </span>
    </a>
  )
}
